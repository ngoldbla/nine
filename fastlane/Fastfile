default_platform(:ios)

# Reuse the existing App Store Connect API key for match + pilot.
# Supports either a .p8 file path (ASC_KEY_PATH) or base64 content (ASC_KEY_P8),
# mirroring scripts/testflight.sh so local and CI auth stay identical.
def asc_api_key
  key_id    = ENV["ASC_KEY_ID"].to_s
  issuer_id = ENV["ASC_ISSUER_ID"].to_s
  UI.user_error!("Set ASC_KEY_ID and ASC_ISSUER_ID (did you `source signing.env`?)") if key_id.empty? || issuer_id.empty?
  if (path = ENV["ASC_KEY_PATH"]) && !path.empty?
    app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: path)
  elsif (content = ENV["ASC_KEY_P8"]) && !content.empty?
    app_store_connect_api_key(
      key_id: key_id, issuer_id: issuer_id,
      key_content: content, is_key_content_base64: true
    )
  else
    UI.user_error!("Set ASC_KEY_PATH (a .p8 file) or ASC_KEY_P8 (base64 of the .p8)")
  end
end

# The app this repo ships: folder => Xcode scheme + bundle identifier.
# Match profile naming:
#   tvOS: "match AppStore <bundle> tvos"   ·   iOS: "match AppStore <bundle>"
#
# This was a five-entry map until the four sibling Couch Suite apps moved to
# repositories of their own (ngoldbla/{rabbit-ears,darkroom,blockhead,cartridge}).
# The map, and the per-app lane machinery below, survive the reduction unchanged
# because Nine is the one app that actually needs them: it is universal, so
# `beta` still takes a `platform:` and `beta_app` still loops over three.
APPS = {
  # `extensions` are iOS-only embedded targets: each needs its own match
  # profile fetched and its own entry in gym's provisioningProfiles.
  # `mac: true` apps also ship a native macOS build (PRD-4) from the same
  # universal target; the widget extension stays iOS-only.
  #
  # The watch app (PRD-6) is not an extension, but it is embedded on the same
  # terms — one more bundle id needing one more profile fetched and one more
  # entry in the export map — so it rides this list rather than earning a
  # mechanism of its own. It needs no `platform:` leg either: a watch app ships
  # *inside* the iOS ipa, so `beta app:nine platform:ios` already carries it.
  "nine"        => { scheme: "Nine",       bundle: "com.couchsuite.nine", ios: true, mac: true,
                     extensions: ["com.couchsuite.nine.widgets",
                                  "com.couchsuite.nine.watchkitapp"] }
}.freeze

# Added to `git rev-list --count HEAD` before the ×10 + platform offset in
# `beta`. Never lower it: that would hand out numbers ASC already holds.
BUILD_BASE_COMMITS = 100

# ------------------------------------------------------------- App Store
#
# Everything below `beta_all` is the store half: metadata, screenshots, age
# rating and submission, all through `deliver`. It never uploads a binary —
# builds reach App Store Connect through `beta` and are *picked* by `release`
# by number, so the one pipeline that signs is the one that has been proven.
#
# Store lanes take the same `platform:` vocabulary as `beta`; deliver calls the
# same three things ios / appletvos / osx.
STORE_PLATFORMS = { "ios" => "ios", "tvos" => "appletvos", "mac" => "osx" }.freeze
# What goes to the App Store (owner decisions): iOS with the embedded watch
# app, and macOS, since 2026-10-13; Apple TV joins with 1.2 (2026-10-23), after
# the tvOS repair pass made it playable on a television.
RELEASE_PLATFORMS = %w[ios tvos mac].freeze
STORE_DIR = File.expand_path(".", __dir__)

# Screenshot sets that are committed rather than regenerated, kept in their own
# folder and merged into the platform's set at upload. The iPhone Duo frames
# need a person in Device Hub to reshoot (no tool sets the posture). (The Apple
# TV set is committed too, but in place — `screenshots/tvos/` is the whole
# platform set, so it needs no merge; see `.gitignore`.)
COMMITTED_SHOT_DIRS = { "ios" => %w[ios-duo] }.freeze

# App Store Connect's limits, checked here so a too-long field fails on the
# laptop instead of halfway through an upload. Keywords are bytes, not
# characters, which matters the moment a locale is not ASCII.
STORE_LIMITS = {
  "name.txt" => 30, "subtitle.txt" => 30, "promotional_text.txt" => 170,
  "description.txt" => 4000, "release_notes.txt" => 4000
}.freeze
STORE_REQUIRED = %w[name.txt description.txt keywords.txt support_url.txt privacy_url.txt].freeze

# The order the store pages show, and where each picture comes from: a
# `nine/scripts/shotlist.py` scene in one appearance. Dark-first (README rule
# 5), with one light frame so the page admits light mode exists.
#
# No `home` frame: the iOS home shelf carries the Parlor's "Play together"
# card, and the Parlor is not advertised until the owner says it ships.
STORE_SHOTS = [
  %w[game dark], %w[rose dark], %w[channel dark],
  %w[school dark], %w[game light]
].freeze
# Scenes a store device cannot or should not take. The iPad shelf has no
# "Next channel" pager (the channels are a segmented control), and its channel
# page is a band of cards over an empty two-thirds of the screen — not a frame
# the board owns.
STORE_SHOTS_SKIP = { "ipad-store" => %w[channel] }.freeze

def store_platform!(options, default: "ios")
  plat = options.fetch(:platform, default).to_s
  UI.user_error!("platform must be one of #{STORE_PLATFORMS.keys.join(', ')}") unless STORE_PLATFORMS.key?(plat)
  plat
end

def marketing_version
  yml = File.read(File.expand_path("../nine/project.yml", __dir__))
  yml[/MARKETING_VERSION:\s*"([^"]+)"/, 1] || UI.user_error!("MARKETING_VERSION not found in nine/project.yml")
end

# Shared by every store lane. `force` skips deliver's HTML preview prompt
# (these lanes must run unattended); IAP precheck is off because Nine has none
# and an API key cannot read them anyway.
def store_options(plat)
  {
    api_key: asc_api_key,
    app_identifier: APPS["nine"][:bundle],
    platform: STORE_PLATFORMS.fetch(plat),
    app_version: marketing_version,
    metadata_path: File.join(STORE_DIR, "metadata"),
    screenshots_path: store_screenshots_root(plat),
    app_rating_config_path: File.join(STORE_DIR, "rating_config.json"),
    skip_binary_upload: true,
    skip_app_version_update: false,
    force: true,
    precheck_include_in_app_purchases: false
  }
end

# The folder deliver uploads for a platform: its own set, plus any committed
# set beside it (`COMMITTED_SHOT_DIRS`), copied together into
# `.store-shots/<platform>` so one `overwrite_screenshots` replaces them all.
def store_screenshots_root(plat)
  base = File.join(STORE_DIR, "screenshots", plat)
  extras = COMMITTED_SHOT_DIRS.fetch(plat, [])
  return base if extras.empty?
  staged = File.join(STORE_DIR, ".store-shots", plat)
  FileUtils.rm_rf(staged)
  ([plat] + extras).each do |dir|
    Dir[File.join(STORE_DIR, "screenshots", dir, "*")].select { |d| File.directory?(d) }.each do |loc_dir|
      dest = File.join(staged, File.basename(loc_dir))
      FileUtils.mkdir_p(dest)
      Dir[File.join(loc_dir, "*.{png,jpg,jpeg}")].each { |f| FileUtils.cp(f, dest) }
    end
  end
  staged
end

def store_locales
  meta = File.join(STORE_DIR, "metadata")
  Dir.children(meta).select { |d| File.directory?(File.join(meta, d)) } -
    %w[review_information trade_representative_contact_information app_clip_review_information]
end

# Offline readiness: both return a list of problems rather than raising, so
# one run reports all of them. Metadata is one tree shared by every platform,
# so it is checked once; screenshots are per platform.
def store_metadata_problems
  problems = []
  meta = File.join(STORE_DIR, "metadata")
  locales = store_locales
  problems << "no locale folders" if locales.empty?
  locales.each do |loc|
    dir = File.join(meta, loc)
    STORE_REQUIRED.each do |f|
      path = File.join(dir, f)
      problems << "#{loc}/#{f}: missing or empty" unless File.exist?(path) && !File.read(path).strip.empty?
    end
    STORE_LIMITS.each do |f, max|
      path = File.join(dir, f)
      next unless File.exist?(path)
      len = File.read(path, encoding: "UTF-8").strip.length
      problems << "#{loc}/#{f}: #{len} characters (limit #{max})" if len > max
    end
    kw = File.join(dir, "keywords.txt")
    if File.exist?(kw)
      text = File.read(kw, encoding: "UTF-8").strip
      problems << "#{loc}/keywords.txt: #{text.bytesize} bytes (limit 100)" if text.bytesize > 100
      problems << "#{loc}/keywords.txt: use commas without spaces" if text =~ /,\s/
    end
    %w[support_url.txt privacy_url.txt marketing_url.txt].each do |f|
      path = File.join(dir, f)
      next unless File.exist?(path)
      url = File.read(path).strip
      problems << "#{loc}/#{f}: not an https URL (#{url})" unless url.empty? || url.start_with?("https://")
    end
  end

  begin
    JSON.parse(File.read(File.join(STORE_DIR, "rating_config.json")))
  rescue StandardError => e
    problems << "rating_config.json: #{e.message}"
  end
  problems
end

def store_screenshot_problems(plat)
  problems = []
  locales = store_locales
  require "deliver"
  shots_root = store_screenshots_root(plat)
  # What ASC refuses to publish without, per platform — each entry a display
  # type prefix. iOS needs a Watch set because NineWatch is embedded; any
  # watch size satisfies it (ASC scales the rest). The Duo set is ours, not
  # ASC's: 1.2 ships the spread, and a page that omits it undersells it.
  # APP_IPHONE_DUO needs deliver 2.241+ (both postures are one display type).
  required = {
    "ios" => %w[APP_IPHONE_67 APP_IPAD_PRO_3GEN_129 APP_WATCH_ APP_IPHONE_DUO],
    "tvos" => %w[APP_APPLE_TV],
    "mac" => %w[APP_DESKTOP]
  }.fetch(plat)
  allowed = {
    "ios" => %w[APP_IPHONE_ APP_IPAD_ APP_WATCH_],
    "tvos" => %w[APP_APPLE_TV],
    "mac" => %w[APP_DESKTOP]
  }.fetch(plat)
  locales.each do |loc|
    pngs = Dir[File.join(shots_root, loc, "*.{png,jpg,jpeg}")].sort
    found = Hash.new(0)
    pngs.each do |path|
      type = Deliver::AppScreenshot.calculate_display_type(path)
      if type.nil?
        size = FastImage.size(path)
        problems << "#{loc}/#{File.basename(path)}: #{size&.join('x') || 'unreadable'} is not an App Store size"
      elsif !type.to_s.start_with?(*allowed)
        problems << "#{loc}/#{File.basename(path)}: #{type} does not belong on #{plat}"
      else
        found[type.to_s] += 1
      end
    end
    required.each do |type|
      problems << "#{loc}: no #{type.chomp('_')} set" if found.none? { |t, _| t.start_with?(type) }
    end
    found.each do |type, count|
      problems << "#{loc}: #{count} #{type} shots (limit 10)" if count > 10
    end
  end
  problems
end

platform :ios do
  desc "Build Nine for one platform and upload to TestFlight (platform:tvos|ios|mac, upload:false = dry run)"
  lane :beta do |options|
    app_key = options.fetch(:app, "nine")
    cfg = APPS[app_key] || UI.user_error!("Unknown app '#{app_key}'. One of: #{APPS.keys.join(', ')}")
    plat = options.fetch(:platform, "tvos").to_s
    UI.user_error!("platform must be 'tvos', 'ios' or 'mac'") unless %w[tvos ios mac].include?(plat)
    UI.user_error!("#{app_key} has no iOS build (only: #{APPS.select { |_, c| c[:ios] }.keys.join(', ')})") if plat == "ios" && !cfg[:ios]
    UI.user_error!("#{app_key} has no macOS build (only: #{APPS.select { |_, c| c[:mac] }.keys.join(', ')})") if plat == "mac" && !cfg[:mac]
    do_upload = options.fetch(:upload, true)
    app_id  = cfg[:bundle]
    scheme  = cfg[:scheme]
    folder  = File.expand_path("../#{app_key}", __dir__)
    profile =
      case plat
      when "ios" then "match AppStore #{app_id}"
      when "mac" then "match AppStore #{app_id} macos"
      else "match AppStore #{app_id} tvos"
      end
    destination =
      case plat
      when "ios" then "generic/platform=iOS"
      when "mac" then "generic/platform=macOS"
      else "generic/platform=tvOS"
      end
    # tvOS/iOS export an .ipa; macOS a signed .pkg.
    output_name = case plat
                  when "ios" then "#{scheme}-iOS.ipa"
                  # gym appends .pkg itself for Mac App Store exports; naming
                  # it here yielded Nine-macOS.pkg.pkg on the first dry run.
                  when "mac" then "#{scheme}-macOS"
                  else "#{scheme}.ipa"
                  end
    # match's platform vocabulary calls the Mac "macos".
    match_platform = plat == "mac" ? "macos" : plat
    # Build number derived from git history — monotonic, never committed back.
    # App Store Connect enforces CFBundleVersion uniqueness per app record (bundle
    # ID), NOT per platform, so a universal app's tvOS/iOS/mac builds must never
    # share a number. Disjoint trains (PR #10): commit-count*10 for tvOS, +1 for
    # iOS, +2 for mac (commit 23 → tvOS 230, iOS 231, mac 232; always above the
    # pre-scheme builds ≤22).
    #
    # The count is lifted by BUILD_BASE_COMMITS (2026-10-17). The repo
    # squash-merges, so a multi-commit branch counts higher than main ever will
    # right after the merge: the 1.1 fix was uploaded from an 86-commit branch
    # as iOS 861 while main stood at 74, leaving main's next builds numbered
    # below it and its 86th commit set to collide with it. The base puts main
    # back above every number ASC holds (main commit 76 → 1760/1761/1762), and
    # the workflow now refuses uploads from any ref but main so it stays there.
    train = { "tvos" => 0, "ios" => 1, "mac" => 2 }.fetch(plat)
    commit_count = sh("git", "-C", File.expand_path("..", __dir__), "rev-list", "--count", "HEAD").strip
    build = ((Integer(commit_count) + BUILD_BASE_COMMITS) * 10 + train).to_s

    # Embedded extensions ship on iOS only (the widget is filtered out of the
    # tvOS and macOS dependency graphs in project.yml).
    extensions = plat == "ios" ? Array(cfg[:extensions]) : []

    key = asc_api_key
    setup_ci # temp keychain on CI; no-op locally

    # readonly: fetch the existing cert + profile from the match repo, never mint.
    # The Mac App Store pkg is signed by a separate installer certificate, so
    # the mac leg must ask match for that type too or gym's pkg step finds no
    # installer identity in the (CI temp) keychain.
    extra_certs = plat == "mac" ? ["mac_installer_distribution"] : []
    match(type: "appstore", platform: match_platform, app_identifier: [app_id] + extensions,
          additional_cert_types: extra_certs, api_key: key, readonly: true)

    Dir.chdir(folder) { sh("xcodegen", "generate") }

    gym_params = {
      project: "#{folder}/#{scheme}.xcodeproj",
      scheme: scheme,
      destination: destination,
      export_method: "app-store",
      output_directory: "#{folder}/dist",
      output_name: output_name,
      xcargs: "CURRENT_PROJECT_VERSION=#{build}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: extensions.each_with_object(app_id => profile) { |ext, map|
          map[ext] = "match AppStore #{ext}"
        }
      }
    }
    # On a multiplatform project gym only takes its pkg (Mac App Store) branch
    # when the sdk names the Mac — without this it walks the iOS path and dies
    # with "IPA invalid" after a perfectly good export (gym module.rb:70).
    gym_params[:sdk] = "macosx" if plat == "mac"
    gym(gym_params)

    if do_upload
      # Be explicit about the artifact + platform. On the mac leg gym produces a
      # .pkg, but pilot defaults to "ipa preferred" and would re-upload the
      # leftover Nine-iOS.ipa from the iOS leg (a build-number collision, since
      # that ipa was just uploaded). Point mac at its pkg with app_platform osx;
      # iOS/tvOS pass their ipa explicitly so no stray artifact can be picked.
      upload_params = { api_key: key, app_identifier: app_id, skip_waiting_for_build_processing: true }
      if plat == "mac"
        upload_params[:app_platform] = "osx"
        upload_params[:pkg] = "#{folder}/dist/#{output_name}.pkg"
      else
        upload_params[:ipa] = "#{folder}/dist/#{output_name}"
      end
      pilot(upload_params)
      UI.success("#{app_key} (#{plat}) build #{build} uploaded to TestFlight")
    else
      UI.success("#{app_key} (#{plat}) build #{build} exported (dry run): #{app_key}/dist/#{output_name}")
    end
  end

  desc "Ship every platform build for one app: tvOS, plus iOS/macOS when universal (upload:false = dry run)"
  lane :beta_app do |options|
    app_key = options.fetch(:app)
    cfg = APPS[app_key] || UI.user_error!("Unknown app '#{app_key}'. One of: #{APPS.keys.join(', ')}")
    beta(options.merge(platform: "tvos"))
    beta(options.merge(platform: "ios")) if cfg[:ios]
    # The mac profiles aren't minted yet (needs the Mac Installer Distribution
    # cert — PRD-4 §4 Step 1). Until they are, CI's beta_all must not attempt
    # the mac leg; mint with `fastlane beta app:nine platform:mac upload:false`
    # directly, then flip COUCH_SHIP_MAC=1 in CI (or drop this guard).
    beta(options.merge(platform: "mac")) if cfg[:mac] && ENV["COUCH_SHIP_MAC"] == "1"
  end

  # Retained as the name CI and muscle memory both reach for. With one app in
  # APPS it is beta_app; it stays a loop so nothing has to change if a second
  # app ever lands here again.
  desc "Build + upload every platform of every app in APPS (upload:false = dry run)"
  lane :beta_all do |options|
    APPS.each_key { |app_key| beta_app(options.merge(app: app_key)) }
  end

  # ----------------------------------------------------------- App Store

  desc "Offline store readiness: metadata limits, required fields, rating JSON, screenshot sizes (platform:release|all|ios|tvos|mac, screenshots:false)"
  lane :store_check do |options|
    plats = case options.fetch(:platform, "release").to_s
            when "release" then RELEASE_PLATFORMS
            when "all" then STORE_PLATFORMS.keys
            else [store_platform!(options)]
            end
    with_shots = options.fetch(:screenshots, true).to_s != "false"
    report = { "metadata" => store_metadata_problems }
    plats.each { |plat| report["screenshots/#{plat}"] = store_screenshot_problems(plat) } if with_shots
    report.each do |plat, problems|
      if problems.empty?
        UI.success("#{plat}: ready")
      else
        problems.each { |p| UI.error("#{plat}: #{p}") }
      end
    end
    total = report.values.sum(&:size)
    UI.user_error!("#{total} store problem(s) — see above") unless total.zero?
  end

  desc "Download what App Store Connect holds now into fastlane/.asc-pull/<platform> (never touches metadata/)"
  lane :store_pull do |options|
    plat = store_platform!(options)
    require "deliver"
    require "deliver/setup"
    out = File.join(STORE_DIR, ".asc-pull", plat)
    FileUtils.rm_rf(out)
    FileUtils.mkdir_p(out)
    config = FastlaneCore::Configuration.create(
      Deliver::Options.available_options,
      store_options(plat).merge(metadata_path: out).except(:app_version)
    )
    Deliver::Runner.new(config) # logs in and resolves the app record
    app = Deliver.cache[:app]
    version = app.get_latest_app_store_version(platform: Spaceship::ConnectAPI::Platform.map(config[:platform]))
    UI.user_error!("No App Store version exists yet for #{plat}") unless version
    Deliver::Setup.new.generate_metadata_files(app, version, out, config)
    UI.success("#{plat} #{version.version_string} (#{version.app_store_state}) → #{out}")
    UI.message("Compare with: diff -ru fastlane/.asc-pull/#{plat} fastlane/metadata")
  end

  desc "Upload metadata + age rating for one platform; no screenshots, no binary (platform:ios|tvos|mac)"
  lane :store_metadata do |options|
    plat = store_platform!(options)
    store_check(platform: plat, screenshots: false)
    deliver(store_options(plat).merge(skip_screenshots: true))
  end

  desc "Capture the iOS store screenshots on 6.9\" iPhone + 13\" iPad simulators via nine/scripts/shotlist.py (macOS only)"
  lane :store_screenshots_capture do |options|
    UI.user_error!("Simulator capture needs macOS + Xcode; this host is #{RUBY_PLATFORM}") unless FastlaneCore::Helper.mac?
    nine = File.expand_path("../nine", __dir__)
    raw = File.join(nine, ".build", "store-shots")
    dest = File.join(STORE_DIR, "screenshots", "ios", "en-US")
    FileUtils.rm_rf(raw)
    FileUtils.mkdir_p(dest)
    Dir.chdir(nine) { sh("xcodegen", "generate") } unless options[:no_build]
    %w[iphone-store ipad-store].each_with_index do |device, i|
      scenes = (STORE_SHOTS.map(&:first).uniq - STORE_SHOTS_SKIP.fetch(device, [])).join(",")
      args = ["python3", "scripts/shotlist.py", "--device", device, "--appearance", "both",
              "--scenes", scenes, "--out", raw]
      # The second device reuses the first device's build products: the
      # simulator slice is the same binary.
      args << "--no-build" if options[:no_build] || i.positive?
      Dir.chdir(nine) { sh(*args) }
    end
    Dir[File.join(dest, "*.png")].each { |f| File.delete(f) }
    %w[iphone-store ipad-store].each do |device|
      STORE_SHOTS.each_with_index do |(scene, appearance), i|
        next if STORE_SHOTS_SKIP.fetch(device, []).include?(scene)
        src = File.join(raw, "#{device}-#{appearance}-#{scene}.png")
        UI.user_error!("shotlist did not produce #{src}") unless File.exist?(src)
        # deliver orders a set by filename and sorts sets by pixel size, so
        # one folder can hold both devices.
        FileUtils.cp(src, File.join(dest, format("%02d-%s-%s-%s.png", i + 1, device, scene, appearance)))
      end
    end
    store_check(platform: "ios")
    UI.success("#{Dir[File.join(dest, '*.png')].size} screenshots in fastlane/screenshots/ios/en-US")
  end

  desc "Replace the screenshots on App Store Connect with fastlane/screenshots/<platform> (platform:ios|tvos|mac)"
  lane :store_screenshots do |options|
    plat = store_platform!(options)
    store_check(platform: plat)
    deliver(store_options(plat).merge(skip_metadata: true, overwrite_screenshots: true))
  end

  desc "Attach an uploaded build, push metadata + screenshots, and (submit:true) send for review (platform:ios|tvos|mac build:<CFBundleVersion>)"
  lane :release do |options|
    plat = store_platform!(options)
    unless RELEASE_PLATFORMS.include?(plat) || options[:force_platform]
      UI.user_error!("#{plat} is not in this release (RELEASE_PLATFORMS: #{RELEASE_PLATFORMS.join(', ')})")
    end
    build = options[:build].to_s
    # No default on purpose: HEAD's commit count is not the number of the build
    # that was tested. Name the one TestFlight already has.
    UI.user_error!("Pass build:<number> — the CFBundleVersion of a build already on TestFlight") if build.empty?
    store_check(platform: plat)
    submit = options.fetch(:submit, false) == true || options[:submit].to_s == "true"
    deliver(store_options(plat).merge(
      build_number: build,
      overwrite_screenshots: true,
      submit_for_review: submit,
      # Release is a human's button, never an approval's side effect.
      automatic_release: false,
      run_precheck_before_submit: submit,
      submission_information: {
        add_id_info_uses_idfa: false,
        # Matches ITSAppUsesNonExemptEncryption: false in nine/project.yml.
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    ))
    UI.success(submit ? "#{plat} #{marketing_version} (#{build}) submitted for review" :
                        "#{plat} #{marketing_version} (#{build}) staged — re-run with submit:true to send for review")
  end
end
