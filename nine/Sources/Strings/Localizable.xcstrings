    "tutorial.goal.body": {
      "comment": "The rules of sudoku in one sentence, plus what this practice board is. \"Box\" is the 3×3 block — use this language's sudoku vocabulary. The dash is an em dash; the range is an en dash.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "املأ كل صف وعمود ومربع 3×3 بالأرقام 1–9 – كل رقم مرة واحدة تمامًا. هذه اللوحة شبه مكتملة؛ ستُنهي جزءًا منها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omple cada fila, columna i bloc de 3×3 amb 1–9, cada dígit exactament un cop. Aquest tauler és gairebé acabat; n'enllestiràs un tros."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Udfyld hver række, kolonne og 3×3-boks med 1–9 – hvert ciffer præcis én gang. Dette bræt er næsten færdigt; du afslutter en del af det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fülle jede Zeile, jede Spalte und jeden 3×3-Block mit 1–9 – jede Ziffer genau einmal. Dieses Spielfeld ist fast fertig; du beendest ein Stück davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill every row, column and 3×3 box with 1–9 — each digit exactly once. This board is nearly done; you'll finish a piece of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Completa cada fila, cada columna y cada caja de 3×3 con los números del 1 al 9 — cada uno una sola vez. Este tablero está casi terminado; tú completarás una parte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Täytä jokainen rivi, sarake ja 3×3-lohko numeroilla 1–9 – jokainen numero täsmälleen kerran. Tämä ruudukko on lähes valmis; viimeistelet sen yhden osan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remplissez chaque ligne, chaque colonne et chaque bloc de 3×3 avec 1–9 — chaque chiffre une seule fois. Cette grille est presque terminée ; vous allez en finir une partie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מלא כל שורה, עמודה ותיבת 3×3 בספרות 1–9 – כל ספרה בדיוק פעם אחת. הלוח הזה כמעט גמור; אתה תשלים חלק ממנו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Töltsön ki minden sort, oszlopot és 3×3-as blokkot az 1–9 számjegyekkel – mindegyiket pontosan egyszer. Ez a tábla majdnem kész; Ön egy részét fejezi be."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fylltu út hverja röð, dálk og 3×3 kassa með 1–9 – hvern tölustaf nákvæmlega einu sinni. Þetta borð er næstum búið; þú klárar hluta af því."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riempi ogni riga, colonna e riquadro 3×3 con 1–9 — ogni cifra una sola volta. Questa griglia è quasi finita; ne completerai un pezzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての行、列、3×3のブロックを1〜9で埋めます。同じ数字は一度だけ。この盤面はあと少しです。その一部を仕上げてみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 가로줄, 세로줄, 3×3 박스를 1–9로 채워요. 각 숫자는 한 번씩만요. 이 보드는 거의 다 됐어요. 남은 부분을 마무리해 봐요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fyll hver rad, kolonne og 3×3-boks med 1–9 – hvert siffer nøyaktig én gang. Dette brettet er nesten ferdig; du fullfører en del av det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vul elke rij, elke kolom en elk 3×3-blok met 1–9 — elk cijfer precies één keer. Dit bord is bijna klaar; jij maakt er een stukje van af."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preencha cada linha, coluna e bloco 3×3 com 1–9 — cada número exatamente uma vez. Este tabuleiro está quase pronto; você vai terminar um pedaço dele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fyll varje rad, kolumn och 3×3-block med 1–9 – varje siffra exakt en gång. Det här brädet är nästan klart; du avslutar en bit av det."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заповніть кожен рядок, стовпець і блок 3×3 цифрами 1–9 — кожну рівно один раз. Це поле майже готове; ви завершите його частину."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在每一行、每一列和每个 3×3 宫中填入 1–9，每个数字恰好出现一次。这张棋盘快完成了，你来补完其中一段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在每一列、每一欄和每個 3×3 宮中填入 1–9，每個數字恰好出現一次。這張棋盤快完成了，你來補完其中一段。"
          }
        }
      }
    },
