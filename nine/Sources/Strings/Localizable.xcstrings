    "difficulty.gentle.explainer": {
      "comment": "The longer explanation of the Gentle band, in the difficulty guide. \"A single\" is the sudoku term for a square with only one possibility. Two short sentences — the guide has no room to scroll.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كل خطوة هي رقم منفرد: مكان واحد يمكن أن يوضع فيه رقم. لوحة أولى هادئة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada pas és un individual: un sol lloc on pot anar un dígit. Un primer tauler tranquil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvert trin er en single: ét sted, et ciffer kan stå. Et roligt første bræt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder Schritt ist ein Single: nur ein Platz bleibt für die Ziffer. Ein ruhiges erstes Spielfeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every step is a single: one place a digit can go. A calm first board."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada paso es un único: un solo sitio donde cabe un número. Un primer tablero tranquilo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jokainen askel on single: yksi paikka, johon numero voi mennä. Rauhallinen ensimmäinen ruudukko."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque étape est un singleton : une seule place possible pour un chiffre. Une première grille tranquille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כל צעד הוא סינגל: מקום אחד שבו ספרה יכולה להיכנס. לוח ראשון רגוע."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minden lépés egy egyes: egyetlen hely, ahová egy számjegy kerülhet. Nyugodt első tábla."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvert skref er einstæður: einn staður þar sem tölustafur getur verið. Rólegt fyrsta borð."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni passo è un singolo: un solo posto dove una cifra può andare. Una prima griglia tranquilla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "どの一手も、数字の入る場所が1つだけ。落ち着いて始められる盤面です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 단계가 싱글이에요: 숫자가 들어갈 자리는 한 곳뿐이죠. 차분한 첫 보드예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvert steg er en single: ett sted et siffer kan stå. Et rolig første brett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke stap is een single: er is maar één plek waar een cijfer kan. Een rustig eerste bord."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada passo é um único: um só lugar para o dígito. Um primeiro tabuleiro calmo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varje steg är en single: en plats där en siffra kan stå. Ett lugnt första bräde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожен крок — одинак: єдине місце, куди може стати цифра. Спокійне перше поле."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每一步都是唯一数：某个数字只有一处可放。安静的第一个棋盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每一步都是唯一數：某個數字只有一處可放。安靜的第一個棋盤。"
          }
        }
      }
    },
