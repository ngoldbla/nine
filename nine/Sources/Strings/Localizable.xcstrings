          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "색칠한 두 그룹 중 한쪽에 %1$lld 후보가 모두 들어 있어요. 그래서 두 그룹을 함께 보는 칸에서는 %1$lld 후보를 지울 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Én av de to skraverte gruppene har alle %1$lld, så ingen rute som ser begge gruppene kan være %1$lld."
