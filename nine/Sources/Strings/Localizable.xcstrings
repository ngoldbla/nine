    "boards.fresh.note": {
      "comment": "Reassurance under the Boards sheet's new-game buttons: starting one destroys nothing.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لوحتك الحالية تبقى في هذه القائمة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El tauler actual es manté a la llista"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit nuværende bræt bliver på listen"
          }
        },
        "de": {
          "stringUnit": {
