    "firstrun.ledger.covenant": {
      "comment": "One line of the welcome card's list, and the promise the whole app is built on. A fragment, no full stop.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بلا إعلانات، بلا اشتراك، ولا شيء آخر للشراء"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sense anuncis, sense subscripció, res més per comprar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen reklamer, intet abonnement, intet andet at købe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Werbung, kein Abo, nichts weiter zu kaufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ads, no subscription, nothing else to buy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sin anuncios, sin suscripción, nada más que comprar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ei mainoksia, ei tilausta, ei mitään muuta ostettavaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas de publicité, pas d’abonnement, rien d’autre à acheter"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בלי פרסומות, בלי מנוי, בלי שום דבר אחר לקנות"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nincs hirdetés, nincs előfizetés, nincs semmi más megvásárolnivaló"
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Engar auglýsingar, engin áskrift, ekkert annað til að kaupa"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna pubblicità, nessun abbonamento, nient'altro da acquistare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "広告なし、サブスクリプションなし、追加購入なし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "광고 없음, 구독 없음, 더 살 것 없음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen annonser, intet abonnement, ingenting annet å kjøpe"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen advertenties, geen abonnement, niets anders te koop"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sem anúncios, sem assinatura, nada mais para comprar"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inga annonser, ingen prenumeration, inget annat att köpa"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Без реклами, без підписки, більше нічого купувати"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有广告，没有订阅，也没有别的要买"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有廣告，沒有訂閱，也沒有別的要買"
          }
        }
      }
    },
    "firstrun.ledger.proof": {
      "comment": "One line of the welcome card's list. \"Proved\" is literal: the app verifies every board is solvable without guessing. A fragment, no full stop. It used to open with a count of difficulty bands and said \"Three\" while there were four, then six — copy that counts something the app can grow does not survive the app growing, so the count is gone rather than corrected.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كل لوحة مثبت أنها قابلة للحل بالمنطق، لا بالتخمين أبدًا"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada tauler demostrat resoluble amb lògica, mai amb endevinacions"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
