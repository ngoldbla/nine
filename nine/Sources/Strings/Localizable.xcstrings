    "coach.exhausted.sentence": {
      "comment": "Coach card body when no technique at this board's level applies.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا شيء على مستوى هذه اللوحة يترتب على ما هنا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Res al nivell d'aquest tauler se'n deriva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet på dette bræts niveau følger herfra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf der Stufe dieses Spielfelds folgt von hier nichts mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing at this board's level follows from here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al nivel de este tablero, de aquí no se deduce nada más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämän ruudukon tasolla mikään ei seuraa tästä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Au niveau de cette grille, plus rien ne se déduit d’ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שום דבר ברמת הלוח הזה לא נובע מכאן."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ennek a táblának a szintjén innen semmi sem következik."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekkert á stigi þessa borðs leiðir af þessu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Da qui non segue nulla al livello di questa griglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この盤面の難度で導ける手は、ここから先にはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 보드의 난이도에서는 여기서 더 이어지는 수가 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingenting på dette brettets nivå følger herfra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Op het niveau van dit bord volgt hier niets uit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada no nível deste tabuleiro segue daqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inget på det här brädets nivå följer härifrån."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На рівні цього поля звідси нічого не випливає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在这个棋盘的难度里，从这里推不出下一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在這個棋盤的難度裡，從這裡推不出下一步。"
          }
        }
      }
    },
