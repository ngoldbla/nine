    "coach.thermoBound.sentence": {
      "comment": "Coach explanation on a Thermo board: digits along a thermometer increase strictly from the round bulb end to the tip, which limits how small or large each square on it can be. %1$lld is the thermometer's length in squares. \"Floor and ceiling\" means a lowest and highest possible digit — phrase it naturally rather than literally.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتصاعد الأرقام من الكرة إلى طرف ميزان الحرارة هذا المكوّن من %1$lld خانة، مما يضع حدًّا أدنى وحدًّا أعلى لكل خانة عليه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els dígits pugen del bulb a la punta d'aquest termòmetre de %1$lld caselles, cosa que posa un mínim i un màxim a cada casella."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cifrene stiger fra kuglen til toppen af dette termometer på %1$lld felter, hvilket giver hvert felt langs det et gulv og et loft."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Ziffern steigen vom Kolben zur Spitze dieses %1$lld-Feld-Thermometers, was jedem Feld darauf eine Unter- und Obergrenze gibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Digits rise from the bulb to the tip of this %1$lld-cell thermometer, which puts a floor and a ceiling on every square along it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los dígitos aumentan del bulbo a la punta de este termómetro de %1$lld casillas, lo que fija un mínimo y un máximo en cada casilla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Numerot kasvavat tämän %1$lld ruudun lämpömittarin kuulasta kärkeen, mikä antaa jokaiselle sen ruudulle alarajan ja ylärajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les chiffres montent du bulbe à la pointe de ce thermomètre de %1$lld cases, ce qui donne un minimum et un maximum à chaque case."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הספרות עולות מהנורה אל הקצה של המדחום הזה בן %1$lld משבצות, ולכן לכל משבצת לאורכו יש רצפה ותקרה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A számjegyek a gömbtől a csúcsig emelkednek ezen a %1$lld mezős hőmérőn, így minden mezőnek van alsó és felső határa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tölustafirnir hækka frá kúlunni að oddi þessa hitamælis með %1$lld reitum, sem gefur hverjum reit á honum gólf og loft."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le cifre crescono dal bulbo alla punta di questo termometro da %1$lld caselle, dando a ogni casella un minimo e un massimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld マスのこのサーモは球部から先端へ数字が増えるので、各マスに下限と上限がつきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld칸 서모는 구근에서 끝으로 숫자가 커지므로 각 칸에 최솟값과 최댓값이 정해집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sifrene stiger fra kulen til toppen av dette termometeret på %1$lld ruter, som gir hver rute langs det et gulv og et tak."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De cijfers stijgen van de bol naar de punt van deze thermometer van %1$lld vakjes, wat elk vakje een onder- en bovengrens geeft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os dígitos aumentam do bulbo à ponta deste termômetro de %1$lld quadrados, o que dá a cada quadrado um mínimo e um máximo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siffrorna stiger från kulan till toppen på den här termometern med %1$lld rutor, vilket ger varje ruta längs den ett golv och ett tak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цифри зростають від колби до кінчика цього термометра з %1$lld клітинок, тож у кожної клітинки на ньому є нижня й верхня межа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "数字沿这个 %1$lld 格温度计从球端向尖端递增，因此每一格都有下限和上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "數字沿這個 %1$lld 格溫度計從球端向尖端遞增，因此每一格都有下限和上限。"
          }
        }
      }
    },
    "coach.xWing.sentence.colBase": {
      "comment": "Coach explanation, X-wing based on two COLUMNS: in two columns the digit can only sit in the same two rows, so it is cleared from the rest of those rows. %1$lld is the digit and appears twice.",
