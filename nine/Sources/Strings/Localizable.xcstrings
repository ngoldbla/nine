    "grammar.pad.pencilDetail": {
      "comment": "The game controller's instruction for pencil notes. \"Square\" is a button name; \"sticky\" means the mode stays on until switched off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اضغط المربع للقلم الثابت ثم اسحب ملاحظة إلى خانة فارغة – صغيرة في الزاوية إلى أن يحلّ رقم حقيقي. المربع مرة أخرى يوقف القلم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prem Quadrat per al llapis fix i llisca una nota a una casella buida: petita a la cantonada fins que aterri un dígit de debò. Quadrat un altre cop apaga el llapis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryk på Firkant for fast blyant, og stryg så en note ind i et tomt felt – lille i hjørnet, til et rigtigt ciffer lander. Firkant igen slår blyanten fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drücke Viereck für den dauerhaften Bleistift und schnippe dann eine Notiz in ein leeres Feld — klein in der Ecke, bis eine echte Ziffer kommt. Noch einmal Viereck schaltet den Bleistift aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Square for sticky pencil, then flick a note into an empty cell — small in the corner until a real digit lands. Square again turns pencil off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pulsa Cuadrado para el lápiz fijo y luego lanza una nota a una casilla vacía: queda pequeña en la esquina hasta que llegue un número de verdad. Otra vez Cuadrado y el lápiz se desactiva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paina Neliötä pysyvää kynää varten ja viistä sitten muistiinpano tyhjään ruutuun – pieni kulmassa, kunnes oikea numero laskeutuu. Neliö uudelleen sammuttaa kynän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appuyez sur Carré pour le crayon permanent, puis envoyez une note dans une case vide d’un coup de stick — petite dans le coin jusqu’à ce qu’un vrai chiffre arrive. Carré à nouveau désactive le crayon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לחץ על ריבוע לעיפרון קבוע, ואז החלק הערה לתוך משבצת ריקה – קטנה בפינה עד שתנחת ספרה אמיתית. ריבוע שוב מכבה את העיפרון."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nyomja meg a Négyzetet a tartós ceruzához, majd pöccintsen egy jegyzetet egy üres mezőbe – kicsiben a sarokban, amíg egy valódi számjegy meg nem érkezik. A Négyzet újabb lenyomása kikapcsolja a ceruzát."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ýttu á Ferning fyrir fastan blýant og strjúktu síðan glósu í tóman reit – lítil í horninu þar til alvöru tölustafur lendir. Ferningur aftur slekkur á blýantinum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Premi Quadrato per la matita fissa, poi lancia una nota in una casella vuota — piccola nell'angolo finché non arriva una cifra vera. Premi di nuovo Quadrato per disattivare la matita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "□ボタンでメモモードを固定し、空きマスにフリックでメモを書きます。確定の数字が入るまで隅に小さく残ります。もう一度□ボタンを押すとメモモードが終わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "네모를 눌러 연필을 켜 두고, 빈 칸으로 메모를 튕겨 넣어요 — 진짜 숫자가 들어올 때까지 구석에 작게 있어요. 네모를 다시 누르면 연필이 꺼져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trykk Firkant for fast blyant, og sveip så et notat inn i en tom rute – lite i hjørnet til et ekte siffer lander. Firkant igjen slår blyanten av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Druk op Vierkant voor vast potlood en zwiep dan een notitie in een leeg vakje — klein in de hoek tot er een echt cijfer landt. Nogmaals Vierkant zet het potlood uit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aperte Quadrado para o lápis fixo e dê um toque no analógico para anotar numa célula vazia — pequena no canto até um dígito de verdade chegar. Quadrado de novo desliga o lápis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryck på Fyrkant för klistrig penna och svep sedan en anteckning till en tom ruta – liten i hörnet tills en riktig siffra landar. Fyrkant igen stänger av pennan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Натисніть Квадрат для постійного олівця, потім змахніть нотатку в порожню клітинку — маленьку в кутку, доки не з’явиться справжня цифра. Ще раз Квадрат вимикає олівець."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按方块键进入常开笔记，然后朝空格轻推，写下一条笔记 —— 它小小地待在角落，直到真正的数字落下。再按一次方块键关闭笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按方塊鍵進入常開筆記，然後朝空格輕推，寫下一條筆記 —— 它小小地待在角落，直到真正的數字落下。再按一次方塊鍵關閉筆記。"
          }
        }
      }
    },
