    "grammar.touch.pencilDetail": {
      "comment": "The touch instruction for pencil notes. \"Note\" is a verb in the second sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "القلم قيد التشغيل. المس خانة فارغة ودوّن رقمًا تفكر فيه – تبقى الملاحظات صغيرة في الزاوية إلى أن يحلّ رقم حقيقي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El llapis és actiu. Toca una casella buida i anota un dígit que estiguis considerant: les notes queden petites a la cantonada fins que aterri un dígit de debò."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blyanten er slået til. Tryk på et tomt felt, og notér et ciffer, du overvejer – noter sidder små i hjørnet, til et rigtigt ciffer lander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Bleistift ist an. Tippe ein leeres Feld an und notiere eine Ziffer, die du erwägst — Notizen sitzen klein in der Ecke, bis eine echte Ziffer kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencil is on. Tap an empty cell and note a digit you're considering — notes sit small in the corner until a real digit lands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El lápiz está activado. Toca una casilla vacía y anota un número que estés valorando: las notas quedan pequeñas en la esquina hasta que llega un número de verdad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kynä on päällä. Napauta tyhjää ruutua ja tee muistiinpano numerosta, jota harkitset – muistiinpanot ovat pieniä kulmassa, kunnes oikea numero laskeutuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le crayon est actif. Touchez une case vide et notez un chiffre que vous envisagez — les notes restent petites dans le coin jusqu’à ce qu’un vrai chiffre arrive."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "העיפרון פועל. הקש על משבצת ריקה ורשום ספרה שאתה שוקל – הערות נשארות קטנות בפינה עד שתנחת ספרה אמיתית."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A ceruza be van kapcsolva. Koppintson egy üres mezőre, és jegyezzen fel egy számjegyet, amelyet fontolgat – a jegyzetek kicsik maradnak a sarokban, amíg egy valódi számjegy meg nem érkezik."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blýanturinn er á. Pikkaðu á tóman reit og skrifaðu tölustaf sem þú ert að íhuga – glósur haldast litlar í horninu þar til alvöru tölustafur lendir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La matita è attiva. Tocca una casella vuota e annota una cifra che stai valutando — le note restano piccole nell'angolo finché non arriva una cifra vera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メモモードが入っています。空きマスをタップして、迷っている数字を書き留めます。メモは確定の数字が入るまで隅に小さく残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연필이 켜져 있어요. 빈 칸을 탭하고 생각 중인 숫자를 메모해요 — 메모는 진짜 숫자가 들어올 때까지 구석에 작게 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blyanten er på. Trykk på en tom rute og noter et siffer du vurderer – notater ligger små i hjørnet til et ekte siffer lander."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Potlood staat aan. Tik op een leeg vakje en noteer een cijfer dat je overweegt — notities staan klein in de hoek tot er een echt cijfer landt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O lápis está ligado. Toque numa célula vazia e anote um dígito que você está considerando — as anotações ficam pequenas no canto até um dígito de verdade chegar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pennan är på. Tryck på en tom ruta och anteckna en siffra du överväger – anteckningar ligger små i hörnet tills en riktig siffra landar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Олівець увімкнено. Торкніться порожньої клітинки й запишіть цифру, яку розглядаєте, — нотатки лишаються маленькими в кутку, доки не з’явиться справжня цифра."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "笔记已打开。轻点空格，记下你正在考虑的数字 —— 笔记小小地待在角落，直到真正的数字落下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "筆記已開啟。輕點空格，記下你正在考慮的數字 —— 筆記小小地待在角落，直到真正的數字落下。"
          }
        }
      }
    },
