    "coach.boxLine.sentence.boxToCol": {
      "comment": "Coach explanation, box-line reduction pointing OUT of a box along a COLUMN. %1$lld is the digit, %2$lld the box number, %3$lld the column number. %1$lld and %3$lld each appear twice.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كل مواضع الرقم %1$lld المحتملة في المربع %2$lld تقع في العمود %3$lld، لذا لا يمكن لأي خانة أخرى في العمود %3$lld أن تكون %1$lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tots els %1$lld que encara són possibles al bloc %2$lld són a la columna %3$lld, així que cap altra casella de la columna %3$lld pot ser %1$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle %1$lld, der stadig er mulige i boks %2$lld, ligger i kolonne %3$lld, så ingen andre felter i kolonne %3$lld kan være %1$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede noch mögliche %1$lld in Block %2$lld liegt in Spalte %3$lld, also kann kein anderes Feld in Spalte %3$lld eine %1$lld sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every %1$lld still possible in box %2$lld sits in column %3$lld, so no other square in column %3$lld can be a %1$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los %1$lld que aún caben en el bloque %2$lld están en la columna %3$lld, así que ninguna otra casilla de la columna %3$lld puede ser un %1$lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Numero %1$lld voi vielä olla lohkossa %2$lld vain sarakkeessa %3$lld, joten mikään muu sarakkeen %3$lld ruutu ei voi olla numero %1$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tous les %1$lld encore possibles dans le bloc %2$lld sont dans la colonne %3$lld, donc aucune autre case de la colonne %3$lld ne peut être un %1$lld."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כל המקומות שבהם הספרה %1$lld עדיין אפשרית בתיבה %2$lld נמצאים בעמודה %3$lld, ולכן אף משבצת אחרת בעמודה %3$lld לא יכולה להיות %1$lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A(z) %2$lld. blokkban %1$lld összes lehetséges helye a(z) %3$lld. oszlopban van, így a(z) %3$lld. oszlop egyetlen más mezője sem lehet %1$lld."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allir mögulegir staðir fyrir %1$lld í kassa %2$lld eru í dálki %3$lld, svo enginn annar reitur í dálki %3$lld getur verið %1$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni %1$lld ancora possibile nel riquadro %2$lld si trova nella colonna %3$lld, quindi nessun'altra casella della colonna %3$lld può essere un %1$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$lldブロックで %1$lld が入りうるマスはすべて %3$lld列にあるので、%3$lld列の他のマスに %1$lld は入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$lld번 박스의 %1$lld 후보가 모두 %3$lld열에 있어요. 그래서 %3$lld열의 나머지 칸에서는 %1$lld 후보를 지울 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle %1$lld som fortsatt er mulige i boks %2$lld ligger i kolonne %3$lld, så ingen andre ruter i kolonne %3$lld kan være %1$lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke plek waar %1$lld nog kan in blok %2$lld ligt in kolom %3$lld, dus geen ander vakje in kolom %3$lld kan een %1$lld zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todo %1$lld ainda possível no bloco %2$lld está na coluna %3$lld, então nenhuma outra célula da coluna %3$lld pode ser %1$lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alla %1$lld som fortfarande är möjliga i block %2$lld ligger i kolumn %3$lld, så ingen annan ruta i kolumn %3$lld kan vara %1$lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усі можливі місця для цифри %1$lld у блоці %2$lld лежать у стовпці %3$lld, тож жодна інша клітинка стовпця %3$lld не може містити цифру %1$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第 %2$lld 宫里还能放 %1$lld 的格子都在第 %3$lld 列，所以第 %3$lld 列的其他格子都不能是 %1$lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第 %2$lld 宮裡還能放 %1$lld 的格子都在第 %3$lld 欄，所以第 %3$lld 欄的其他格子都不能是 %1$lld。"
          }
        }
      }
    },
    "coach.boxLine.sentence.boxToRow": {
      "comment": "Coach explanation, box-line reduction pointing OUT of a box along a ROW: every place the digit can still go in that box lies on that row, so the rest of the row is clear of it. %1$lld is the digit, %2$lld the box number, %3$lld the row number. %1$lld and %3$lld each appear TWICE — if you reorder, move every occurrence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كل مواضع الرقم %1$lld المحتملة في المربع %2$lld تقع في الصف %3$lld، لذا لا يمكن لأي خانة أخرى في الصف %3$lld أن تكون %1$lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tots els %1$lld que encara són possibles al bloc %2$lld són a la fila %3$lld, així que cap altra casella de la fila %3$lld pot ser %1$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle %1$lld, der stadig er mulige i boks %2$lld, ligger i række %3$lld, så ingen andre felter i række %3$lld kan være %1$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede noch mögliche %1$lld in Block %2$lld liegt in Zeile %3$lld, also kann kein anderes Feld in Zeile %3$lld eine %1$lld sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every %1$lld still possible in box %2$lld sits in row %3$lld, so no other square in row %3$lld can be a %1$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los %1$lld que aún caben en el bloque %2$lld están en la fila %3$lld, así que ninguna otra casilla de la fila %3$lld puede ser un %1$lld."
          }
        },
        "fi": {
