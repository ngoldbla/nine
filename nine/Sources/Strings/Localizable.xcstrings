    "shelf.grace.body": {
      "comment": "Body of the streak-held card. Says the missed day cost nothing, without framing rest as something spent — there is no allowance and no counter.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أخذت أمس يوم راحة؛ يوم راحة واحد لا يكلّفك شيئًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ahir et vas prendre un dia lliure; un dia de descans no et costa res."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du holdt fri i går; én hviledag koster dig ingenting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gestern hast du pausiert; ein Ruhetag kostet dich nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You took yesterday off; one rest day won't cost you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ayer te tomaste el día; un día de descanso no te cuesta nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pidit eilen vapaapäivän; yksi lepopäivä ei maksa sinulle mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez fait une pause hier ; un jour de repos ne coûte rien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לקחת אתמול יום חופש; יום מנוחה אחד לא עולה לך בדבר."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tegnap szabadnapot tartott; egy pihenőnap nem kerül semmibe."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Þú tókst þér frí í gær; einn hvíldardagur kostar þig ekkert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ieri hai fatto una pausa; un giorno di riposo non ti costa nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "昨日はお休みでした。一日休んでも途切れることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "어제는 쉬었네요. 하루쯤 쉬어도 괜찮아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du tok en fridag i går; én hviledag koster deg ingenting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je hebt gisteren rust genomen; één rustdag kost je niets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você descansou ontem; um dia de descanso não custa nada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du tog igår ledigt; en vilodag kostar dig ingenting."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Учора ви взяли вихідний; один день відпочинку вам нічого не коштує."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你昨天休息了一天，歇一天不会有任何影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你昨天休息了一天，歇一天不會有任何影響。"
          }
        }
      }
    },
    "shelf.grace.hint": {
      "comment": "VoiceOver hint on the streak-held card: tapping it only makes it go away. A verb phrase in the third person, as VoiceOver hints are.",
