          "stringUnit": {
            "state": "needs_review",
            "value": "Пари та блок-лінії"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "数对与区块"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "數對與區塊"
          }
        }
      }
    },
    "difficulty.steady.explainer": {
      "comment": "The longer explanation of the Steady band. \"Naked pair\" and \"box-line elimination\" are sudoku terms of art. Two short sentences.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتطلب الأزواج العارية واستبعاد المربع-الخط. تبدأ الملاحظات في الإفادة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Necessita parelles nues i eliminacions de bloc-línia. Les notes comencen a donar fruit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kræver nøgne par og boks-linje-elimineringer. Noter begynder at betale sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Braucht nackte Paare und Blocklinien-Streichungen. Notizen zahlen sich aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs naked pairs and box-line eliminations. Pencil marks start to pay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Necesita pares desnudos y eliminaciones caja-línea. Las anotaciones empiezan a compensar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaatii paljaita pareja ja lohko-rivi-eliminointeja. Muistiinpanoista alkaa olla hyötyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demande des paires nues et des éliminations bloc-ligne. Les notes commencent à payer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "דורש זוגות חשופים והפחתת תיבה-קו. ההערות מתחילות להשתלם."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Csupasz párokat és blokk-sor kizárásokat igényel. A jegyzetek kezdenek kifizetődni."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krefst nakinna para og kassa-línu útilokana. Glósur byrja að borga sig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Servono coppie nude ed eliminazioni riga-blocco. Le note a matita iniziano a ripagare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ネイキッドペアとボックスライン除外が必要です。メモが効いてきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "네이키드 페어와 박스-라인 소거가 필요해요. 연필 메모가 힘을 발휘하기 시작해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krever nakne par og boks-linje-elimineringer. Notater begynner å lønne seg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vraagt om naakte paren en blok-lijn-eliminaties. Potloodnotities gaan lonen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pede pares nus e eliminações por linha de bloco. As anotações começam a valer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kräver nakna par och block-rad-elimineringar. Anteckningar börjar löna sig."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Потребує голих пар і виключень блок-лінія. Нотатки починають окупатися."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要显性数对和区块摒除。笔记开始派上用场。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要顯性數對和區塊摒除。筆記開始派上用場。"
          }
        }
      }
    },
