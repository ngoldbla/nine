    "debrief.placements": {
      "comment": "One of the counts on the debrief card, joined by middle dots: how many digits the player committed over the whole solve, corrections included. Neutral — this is not a score and nothing is being judged. PLURAL: %1$lld is the count, 0 or more.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%1$lld أرقام موضوعة"
                }
              },
              "many": {
                "stringUnit": {
