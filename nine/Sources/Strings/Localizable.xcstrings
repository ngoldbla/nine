    "debrief.fastest": {
      "comment": "Debrief line naming the 3x3 box the player filled with the least hesitation. %1$@ is already-translated text like \"Box 4\" (board.unit.box). The separator is a middle dot. English says \"region\" because it is a different word from \"Box\"; if your language would repeat board.unit.box's noun here, drop the noun instead (\"Fastest - Block 4\") rather than saying it twice.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أسرع منطقة · %1$@"
          }
        },
        "ca": {
