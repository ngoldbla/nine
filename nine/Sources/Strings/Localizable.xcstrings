    "school.lesson.look": {
      "comment": "Instruction at the start of a lesson, before the pattern is revealed. \"Settled\" means the square's digit is now forced. Encourages looking before being told.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في مكان ما على هذه اللوحة خانة واحدة محسومة. انظر أولًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En algun lloc d'aquest tauler hi ha una casella resolta. Mira primer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et sted på dette bræt er ét felt afgjort. Kig først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Irgendwo auf diesem Brett ist ein Feld bereits festgelegt. Sieh erst selbst nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somewhere on this board, one square is settled. Look first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En algún lugar de este tablero hay una casilla ya determinada. Búscala primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jossain tässä ruudukossa yksi ruutu on ratkennut. Katso ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quelque part sur cette grille, une case est déjà déterminée. Cherche d'abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "איפשהו בלוח הזה משבצת אחת כבר הוכרעה. הסתכל קודם."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valahol ezen a táblán egy mező már eldőlt. Először nézzen körül."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einhvers staðar á þessu borði er einn reitur ráðinn. Líttu fyrst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Da qualche parte in questa griglia una casella è già determinata. Prima cercala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この盤のどこかに、もう決まっているマスがあります。まず探してみて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 판 어딘가에 이미 정해진 칸이 있습니다. 먼저 찾아보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et sted på dette brettet er én rute avgjort. Se først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ergens op dit bord ligt één vakje al vast. Kijk eerst zelf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Em algum lugar deste tabuleiro há uma célula já determinada. Procure primeiro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Någonstans på det här brädet är en ruta avgjord. Titta först."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Десь на цьому полі одну клітинку вже визначено. Спершу придивіться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这盘棋里有一个格子已经定下来了。先自己找找看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這盤棋裡有一個格子已經定下來了。先自己找找看。"
          }
        }
      }
    },
