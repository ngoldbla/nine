    "coach.hiddenPair.sentence.box": {
      "comment": "Coach explanation, hidden pair inside a 3x3 BOX. %1$lld and %2$lld are the digits, %3$lld the box number.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الرقمان %1$lld و%2$lld لا يناسبان في المربع %3$lld إلا هاتين الخانتين، لذا لا يناسب غيرهما هناك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld i %2$lld només caben en aquestes dues caselles del bloc %3$lld, així que no hi cap res més."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld og %2$lld passer kun i disse to felter i boks %3$lld, så intet andet passer dér."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld und %2$lld passen in Block %3$lld nur in diese beiden Felder, also passt dort nichts anderes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld and %2$lld fit only these two squares in box %3$lld, so nothing else fits there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El %1$lld y el %2$lld solo caben en estas dos casillas del bloque %3$lld, así que ahí no cabe nada más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Numerot %1$lld ja %2$lld sopivat lohkossa %3$lld vain näihin kahteen ruutuun, joten mikään muu ei sovi sinne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld et %2$lld ne tiennent que dans ces deux cases du bloc %3$lld, donc rien d’autre n’y tient."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הספרות %1$lld ו-%2$lld מתאימות בתיבה %3$lld רק לשתי המשבצות האלה, ולכן שום דבר אחר לא מתאים שם."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld és %2$lld a(z) %3$lld. blokkban csak e két mezőbe fér, így más nem fér oda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld og %2$lld passa aðeins í þessa tvo reiti í kassa %3$lld, svo ekkert annað passar þar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld e %2$lld entrano solo in queste due caselle del riquadro %3$lld, quindi lì non può stare altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%3$lldブロックでは %1$lld と %2$lld がこの2マスにしか入らないので、この2マスには他の数字は入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%3$lld번 박스에서 %1$lld, %2$lld 두 숫자가 들어갈 자리는 이 두 칸뿐이에요. 그래서 다른 숫자는 여기에 들어갈 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld og %2$lld passer bare i disse to rutene i boks %3$lld, så ingenting annet passer der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld en %2$lld passen alleen in deze twee vakjes in blok %3$lld, dus er kan niets anders in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld e %2$lld cabem só nestas duas células do bloco %3$lld, então nada mais cabe nelas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld och %2$lld passar bara i de här två rutorna i block %3$lld, så inget annat passar där."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цифри %1$lld і %2$lld у блоці %3$lld підходять лише для цих двох клітинок, тож більше нічого туди не підходить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在第 %3$lld 宫里，%1$lld 和 %2$lld 只能放进这两个格子，所以这两格里放不下别的数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在第 %3$lld 宮裡，%1$lld 和 %2$lld 只能放進這兩個格子，所以這兩格裡放不下別的數字。"
          }
        }
      }
    },
