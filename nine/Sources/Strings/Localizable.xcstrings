        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los %1$lld que aún caben en la columna %2$lld están en el bloque %3$lld, así que ninguna otra casilla del bloque %3$lld puede ser un %1$lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Numero %1$lld voi vielä olla sarakkeessa %2$lld vain lohkossa %3$lld, joten mikään muu lohkon %3$lld ruutu ei voi olla numero %1$lld."
