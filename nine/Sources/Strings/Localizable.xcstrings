    "grammar.remote.pencilDetail": {
      "comment": "The Siri Remote's full instruction for pencil notes. \"Rose\" is the circular picker.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اضغط مطولًا على خانة فارغة لوردة القلم. تبقى الملاحظات صغيرة في الزاوية إلى أن يحلّ رقم حقيقي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén clicat sobre una casella buida per a la rosa de llapis. Les notes queden petites a la cantonada fins que aterri un dígit de debò."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold-klik på et tomt felt for blyantrosen. Noter sidder små i hjørnet, til et rigtigt ciffer lander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Halte den Klick auf einem leeren Feld für die Notizrose. Notizen sitzen klein in der Ecke, bis eine echte Ziffer kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold-click an empty cell for the pencil rose. Notes sit small in the corner until a real digit lands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén el clic en una casilla vacía para abrir la rosa de lápiz. Las notas quedan pequeñas en la esquina hasta que llega un número de verdad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paina pitkään tyhjää ruutua kynäruusua varten. Muistiinpanot ovat pieniä kulmassa, kunnes oikea numero laskeutuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites un clic long sur une case vide pour la rose du crayon. Les notes restent petites dans le coin jusqu’à ce qu’un vrai chiffre arrive."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לחיצה ארוכה על משבצת ריקה פותחת את ורד העיפרון. הערות נשארות קטנות בפינה עד שתנחת ספרה אמיתית."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tartsa lenyomva egy üres mezőt a ceruzarózsáért. A jegyzetek kicsik maradnak a sarokban, amíg egy valódi számjegy meg nem érkezik."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haltu smelli á tómum reit fyrir blýantsrósina. Glósur haldast litlar í horninu þar til alvöru tölustafur lendir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clicca e tieni premuto su una casella vuota per la rosa della matita. Le note restano piccole nell'angolo finché non arriva una cifra vera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "空きマスを長押しクリックすると、メモのリングが開きます。メモは確定の数字が入るまで隅に小さく残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "빈 칸을 길게 클릭하면 메모 꽃이 열려요. 메모는 진짜 숫자가 들어올 때까지 구석에 작게 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold-klikk på en tom rute for blyantrosen. Notater ligger små i hjørnet til et ekte siffer lander."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klik lang op een leeg vakje voor de potloodroos. Notities staan klein in de hoek tot er een echt cijfer landt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clique e segure numa célula vazia para abrir a rosa do lápis. As anotações ficam pequenas no canto até um dígito de verdade chegar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Håll-klicka på en tom ruta för pennrosen. Anteckningar ligger små i hörnet tills en riktig siffra landar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Утримуйте клацання на порожній клітинці для троянди олівця. Нотатки лишаються маленькими в кутку, доки не з’явиться справжня цифра."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "长按空格打开笔记花环。笔记小小地待在角落，直到真正的数字落下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "長按空格開啟筆記花環。筆記小小地待在角落，直到真正的數字落下。"
          }
        }
      }
    },
