    "firstrun.ledger.stats": {
      "comment": "One line of the welcome card's list. \"Honestly\" means nothing is inflated or gamified. A fragment, no full stop.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أوقاتك ونقاطك واتجاهاتك – تُسجَّل بأمانة"
