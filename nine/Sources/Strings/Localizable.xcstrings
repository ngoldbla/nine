    "boards.empty": {
      "comment": "What the Boards sheet says when nothing has been played yet. \"Archive\" is a verb: set aside without deleting.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابدأ لوحة وستظهر هنا – استأنفها في أي وقت أو أرشفها لوقت لاحق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comença un tauler i apareixerà aquí: reprèn-lo quan vulguis o arxiva'l per a més endavant."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start et bræt, så havner det her – genoptag det når som helst, eller arkivér det til senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starte ein Spielfeld und es landet hier — nimm es jederzeit wieder auf oder archiviere es für später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a board and it lands here — resume it any time, or archive it for later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Empieza un tablero y aparecerá aquí: retómalo cuando quieras o archívalo para más adelante."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aloita ruudukko, niin se ilmestyy tähän – jatka sitä milloin vain tai arkistoi se myöhemmäksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Commencez une grille et elle apparaîtra ici — reprenez-la quand vous voulez, ou archivez-la pour plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "התחל לוח והוא יופיע כאן – המשך אותו בכל עת, או העבר אותו לארכיון למועד מאוחר יותר."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kezdjen el egy táblát, és itt jelenik meg – folytathatja bármikor, vagy archiválhatja későbbre."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Byrjaðu á borði og það birtist hér – haltu áfram hvenær sem er eða settu það í geymslu til síðari tíma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inizia una griglia e comparirà qui: puoi riprenderla quando vuoi o archiviarla per dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "盤面を始めると、ここに並びます。いつでも再開でき、後のためにアーカイブしておけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보드를 시작하면 여기에 담겨요. 언제든 이어서 풀거나, 나중을 위해 보관할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start et brett, så havner det her – gjenoppta det når som helst, eller arkiver det til senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Begin een bord en het komt hier terecht — hervat het wanneer je wilt, of archiveer het voor later."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comece um tabuleiro e ele fica aqui — retome quando quiser, ou arquive para depois."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starta ett bräde så hamnar det här – återuppta det när som helst, eller arkivera det till senare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Почніть поле, і воно з’явиться тут — продовжуйте будь-коли або заархівуйте на потім."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "开始一个棋盘，它就会出现在这里。你可以随时继续，也可以先归档，留到以后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開始一個棋盤，它就會出現在這裡。你可以隨時繼續，也可以先封存，留到以後。"
          }
        }
      }
    },
