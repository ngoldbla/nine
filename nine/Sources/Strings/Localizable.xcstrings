    "grammar.pad.advanceHint": {
      "comment": "One-line reminder of the game controller's controls, under a tutorial beat. \"Circle\" is a button name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "العصا اليسرى تحرّك · العصا اليمنى تسحب رقمًا · الدائرة تتراجع، والضغط المطول يمسح"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La palanca esquerra mou · la dreta llisca un dígit · Cercle desfà, mantenir esborra"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Venstre stik flytter · højre stik stryger et ciffer · Cirkel fortryder, hold for at slette"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linker Stick bewegt · rechter Stick schnippt eine Ziffer · Kreis widerruft, gehalten löscht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left stick moves · right stick flicks a digit · Circle taps undo, holds to erase"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El stick izquierdo mueve · un golpe del derecho coloca un número · Círculo deshace, mantenlo para borrar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vasen sauva liikuttaa · oikea sauva viistää numeron · Ympyrä kumoaa, pitämällä pyyhkii"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le stick gauche déplace · le stick droit place un chiffre · Rond annule, maintenu il efface"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הסטיק השמאלי מזיז · הסטיק הימני מחליק ספרה · עיגול מבטל, החזקה מוחקת"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A bal kar mozgat · a jobb kar pöccint egy számjegyet · Kör visszavon, hosszan nyomva töröl"
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vinstri stöng hreyfir · hægri stöng strýkur tölustaf · Hringur afturkallar, haldið eyðir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La levetta sinistra sposta · la destra lancia una cifra · Cerchio annulla, tienilo premuto per cancellare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "左スティックで移動 · 右スティックのフリックで入力 · ○ボタンで取り消し、長押しで消去"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "왼쪽 스틱으로 이동 · 오른쪽 스틱으로 숫자 튕기기 · 동그라미는 눌러 실행 취소, 길게 눌러 지우기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Venstre spak flytter · høyre spak sveiper et siffer · Sirkel angrer, hold for å slette"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linkerstick beweegt · rechterstick zwiept een cijfer · Cirkel tikt ongedaan, ingedrukt wist"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analógico esquerdo move · um toque no direito coloca um dígito · Círculo desfaz, segure para apagar"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vänster spak flyttar · höger spak sveper en siffra · Cirkel ångrar, håll för att radera"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лівий стік рухає · правий стік змахує цифру · Коло скасовує, утримання стирає"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "左摇杆移动 · 右摇杆轻推填数 · 圆圈键点按撤销，长按清除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "左搖桿移動 · 右搖桿輕推填數 · 圓圈鍵點按還原，長按清除"
          }
        }
      }
    },
    "grammar.pad.highlightDetail": {
      "comment": "The game controller's instruction for the same-number highlight and the peek. \"Triangle\" and \"L2\" are button names.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قف عند أي رقم موضوع واضغط المثلث – تضيء كل النسخ، والملاحظات أيضًا. اضغط مطولًا على L2 لتعتيم كل شيء عدا هذا النوع. المثلث مرة أخرى يطفئ الأضواء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atura't sobre qualsevol dígit col·locat i prem Triangle: s'il·luminen totes les còpies, també les notes. Mantén L2 per atenuar-ho tot tret d'aquest tipus. Triangle un altre cop apaga els llums."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvil på et placeret ciffer, og tryk på Trekant – alle kopier lyser op, noter også. Hold L2 for at dæmpe alt andet end den slags. Trekant igen slukker lysene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bleibe auf einer gesetzten Ziffer und drücke Dreieck — jede Kopie leuchtet auf, Notizen auch. Halte L2, um alles außer dieser Ziffer abzudunkeln. Noch einmal Dreieck schaltet das Licht aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest on any placed digit and press Triangle — every copy lights up, pencil notes too. Hold L2 to dim everything except that kind. Triangle again switches the lights off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Detente sobre cualquier número colocado y pulsa Triángulo: todas sus copias se iluminan, también las anotaciones. Mantén L2 para atenuar todo lo demás. Otra vez Triángulo y las luces se apagan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pysähdy mihin tahansa asetettuun numeroon ja paina Kolmiota – kaikki kopiot syttyvät, muistiinpanotkin. Pidä L2 painettuna himmentääksesi kaiken muun paitsi sen lajin. Kolmio uudelleen sammuttaa valot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Posez-vous sur un chiffre placé et appuyez sur Triangle — toutes ses copies s’allument, les notes aussi. Maintenez L2 pour estomper tout le reste. Triangle à nouveau éteint tout."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "עצור על ספרה שהוצבה ולחץ על משולש – כל העותקים נדלקים, גם ההערות. החזק L2 כדי לעמעם הכול חוץ מאותו סוג. משולש שוב מכבה את האורות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Álljon meg egy elhelyezett számjegyen, és nyomja meg a Háromszöget – az összes másolat kigyullad, a jegyzetek is. Tartsa lenyomva az L2-t, hogy minden mást elhalványítson. A Háromszög újabb lenyomása kioltja a fényeket."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Staldraðu við á tölustaf og ýttu á Þríhyrning – öll eintök lýsast upp, glósur líka. Haltu L2 til að dimma allt nema þá gerð. Þríhyrningur aftur slekkur ljósin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fermati su una cifra già inserita e premi Triangolo — tutte le sue copie si illuminano, anche le note a matita. Tieni premuto L2 per attenuare tutto tranne quella cifra. Premi di nuovo Triangolo per spegnere le luci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "入力済みの数字に合わせて△ボタンを押すと、同じ数字がすべて光ります。メモの数字も一緒です。L2 を押している間は、その数字以外が暗くなります。もう一度△ボタンを押すと消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "놓인 숫자 위에 멈춰 세모를 눌러요. 같은 숫자가 모두 밝아져요 — 연필 메모까지요. L2를 길게 누르면 그 숫자만 남기고 나머지가 어두워져요. 세모를 다시 누르면 불이 꺼져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvil på et plassert siffer og trykk Trekant – alle kopier lyser opp, notater også. Hold L2 for å dempe alt unntatt den typen. Trekant igjen slukker lysene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blijf op een geplaatst cijfer staan en druk op Driehoek — elk exemplaar licht op, potloodnotities ook. Houd L2 ingedrukt om alles behalve dat soort te dimmen. Nogmaals Driehoek dooft de lichten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pare sobre qualquer dígito colocado e aperte Triângulo — todas as cópias acendem, as anotações também. Segure L2 para escurecer tudo, menos esse dígito. Triângulo de novo apaga as luzes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vila på en placerad siffra och tryck på Triangel – alla kopior lyser upp, anteckningar också. Håll L2 för att dämpa allt utom den sorten. Triangel igen släcker lamporna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зупиніться на будь-якій поставленій цифрі й натисніть Трикутник — усі копії засвітяться, нотатки теж. Утримуйте L2, щоб притлумити все, окрім цього виду. Ще раз Трикутник гасить світло."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "停在任意已填数字上，按三角键 —— 所有相同的数字都会亮起，笔记也一样。按住 L2 可以让其余的都暗下去。再按一次三角键关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "停在任意已填數字上，按三角鍵 —— 所有相同的數字都會亮起，筆記也一樣。按住 L2 可以讓其餘的都暗下去。再按一次三角鍵關閉。"
          }
        }
      }
    },
