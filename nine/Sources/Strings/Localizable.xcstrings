    "grammar.keyboard.placeDetail": {
      "comment": "The Mac keyboard instruction for placing a digit. %1$@ is the target numeral. \"Rose\" is the circular picker the other platforms use; the point is that the Mac needs no picker at all.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انتقل إلى الخانة المضيئة بمفاتيح الأسهم ثم اضغط %1$@. تُكتب الأرقام مباشرة – بلا وردة وبلا أوضاع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Camina fins a la casella lluminosa amb les fletxes i després prem %1$@. Els dígits s'escriuen directament: sense rosa, sense modes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå til det lysende felt med piletasterne, og tryk så på %1$@. Cifre skrives direkte – ingen rose, ingen tilstande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gehe mit den Pfeiltasten zum leuchtenden Feld und drücke %1$@. Ziffern landen direkt — keine Rose, keine Modi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk to the glowing cell with the arrow keys, then press %1$@. Digits type straight in — no rose, no modes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ve hasta la casilla iluminada con las flechas y pulsa %1$@. Los números se escriben directamente: sin rosa, sin modos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kävele hehkuvaan ruutuun nuolinäppäimillä ja paina sitten %1$@. Numerot kirjoitetaan suoraan – ei ruusua, ei tiloja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rejoignez la case qui brille avec les touches fléchées, puis appuyez sur %1$@. Les chiffres s’écrivent directement — sans rose, sans modes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "עבור למשבצת הזוהרת בעזרת מקשי החצים, ואז לחץ על %1$@. ספרות מוקלדות ישירות – בלי ורד, בלי מצבים."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A nyilakkal sétáljon a világító mezőre, majd nyomja meg a(z) %1$@ gombot. A számjegyek közvetlenül beírhatók – nincs rózsa, nincsenek módok."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farðu á lýsandi reitinn með örvunum og ýttu síðan á %1$@. Tölustafir eru slegnir beint inn – engin rós, engir hamir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Raggiungi la casella illuminata con le frecce, poi premi %1$@. Le cifre si digitano direttamente — niente rosa, niente modalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "矢印キーで光っているマスまで進み、%1$@を押します。数字はそのまま入ります。リングもモードも要りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "화살표 키로 빛나는 칸까지 간 다음 %1$@ 키를 눌러요. 숫자는 바로 들어가요 — 꽃도, 모드도 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå til den lysende ruten med piltastene, og trykk så %1$@. Siffer skrives rett inn – ingen rose, ingen moduser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Loop met de pijltoetsen naar het oplichtende vakje en druk op %1$@. Cijfers typ je er zo in — geen roos, geen modi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Caminhe até a célula acesa com as setas e aperte %1$@. Os dígitos entram direto — sem rosa, sem modos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå till den lysande rutan med piltangenterna och tryck sedan på %1$@. Siffror skrivs direkt – ingen ros, inga lägen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Стрілками дійдіть до світної клітинки, потім натисніть %1$@. Цифри вводяться напряму — без троянди й режимів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "用方向键走到发亮的格子，然后按 %1$@。数字直接输入 —— 不用花环，也没有模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "用方向鍵走到發亮的格子，然後按 %1$@。數字直接輸入 —— 不用花環，也沒有模式。"
          }
        }
      }
    },
