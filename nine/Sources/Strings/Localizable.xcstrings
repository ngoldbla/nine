    "why.beyond.sentence": {
      "comment": "The sentence under why.beyond.title. \"This board's level\" is its difficulty band. Declining, never apologising.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا شيء على مستوى هذه اللوحة يحسم هذه الخانة بعد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Res al nivell d'aquest tauler decideix encara aquesta casella."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet på dette bræts niveau afgør dette felt endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf der Stufe dieses Spielfelds ist dieses Feld noch nicht zu klären."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing at this board's level settles this square yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al nivel de este tablero, esta casilla aún no queda resuelta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mikään tämän ruudukon tasolla ei ratkaise tätä ruutua vielä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Au niveau de cette grille, cette case ne se résout pas encore."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שום דבר ברמת הלוח הזה עדיין לא מכריע את המשבצת הזו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ennek a táblának a szintjén semmi sem dönti el még ezt a mezőt."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekkert á stigi þessa borðs ræður þessum reit enn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al livello di questa griglia, questa casella non si risolve ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この盤面の難度では、このマスはまだ決まりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 보드의 난이도로는 이 칸이 아직 정해지지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingenting på dette brettets nivå avgjør denne ruten ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Op het niveau van dit bord is dit vakje nog niet te bepalen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No nível deste tabuleiro, esta célula ainda não se resolve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inget på det här brädets nivå avgör den här rutan ännu."
          }
        },
        "uk": {
