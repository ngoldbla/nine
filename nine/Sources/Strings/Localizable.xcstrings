        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni %1$lld ancora possibile nella colonna %2$lld si trova nel riquadro %3$lld, quindi nessun'altra casella del riquadro %3$lld può essere un %1$lld."
          }
        },
        "ja": {
