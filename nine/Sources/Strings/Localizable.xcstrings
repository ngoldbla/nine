    "grammar.touch.placeDetail": {
      "comment": "The touch instruction for placing a digit. %1$@ is the target numeral. The parenthesis explains that the ring is laid out like a 3×3 number pad.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المس الخانة المضيئة ثم المس %1$@ في الوردة. (يمكنك أيضًا السحب نحوه – الوردة لوحة أرقام بحجم 3×3.)"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca la casella lluminosa i després toca %1$@ a la rosa. (També pots lliscar cap a ell: la rosa és un teclat numèric de 3×3.)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryk på det lysende felt, og tryk så på %1$@ i rosen. (Du kan også stryge mod det – rosen er et 3×3-tastatur.)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe das leuchtende Feld an und dann die %1$@ in der Rose. (Du kannst auch dorthin schnippen — die Rose ist ein 3×3-Ziffernblock.)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the glowing cell, then tap the %1$@ in the rose. (You can also flick toward it — the rose is a 3×3 keypad.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca la casilla iluminada y luego toca el %1$@ en la rosa. (También puedes deslizar rápido hacia él: la rosa es un teclado numérico de 3×3.)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napauta hehkuvaa ruutua ja napauta sitten numeroa %1$@ ruusussa. (Voit myös viistää kohti sitä – ruusu on 3×3-näppäimistö.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez la case qui brille, puis touchez le %1$@ dans la rose. (Vous pouvez aussi faire glisser vers lui — la rose est un pavé 3×3.)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הקש על המשבצת הזוהרת, ואז הקש על %1$@ בוורד. (אפשר גם להחליק לעברה – הוורד הוא מקלדת מספרים בגודל 3×3.)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koppintson a világító mezőre, majd a rózsában a(z) %1$@ számra. (Pöccinthet is felé – a rózsa egy 3×3-as számbillentyűzet.)"
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pikkaðu á lýsandi reitinn og pikkaðu síðan á %1$@ í rósinni. (Þú getur líka strokið í átt að honum – rósin er 3×3 talnaborð.)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tocca la casella illuminata, poi tocca %1$@ nella rosa. (Puoi anche scorrere rapidamente verso la cifra — la rosa è un tastierino 3×3.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "光っているマスをタップし、リングの中の%1$@をタップします。（その方向へフリックしても入ります。リングは 3×3 のキーパッドです。）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "빛나는 칸을 탭한 다음 꽃에서 %1$@ 꽃잎을 탭해요. (그쪽으로 튕겨도 돼요 — 꽃은 3×3 키패드예요.)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trykk på den lysende ruten, og trykk så på %1$@ i rosen. (Du kan også sveipe mot det – rosen er et 3×3-tastatur.)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik op het oplichtende vakje en tik dan op de %1$@ in de roos. (Je kunt er ook naartoe zwiepen — de roos is een 3×3-toetsenblok.)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque na célula acesa e depois no %1$@ da rosa. (Você também pode deslizar na direção dele — a rosa é um teclado 3×3.)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryck på den lysande rutan och tryck sedan på %1$@ i rosen. (Du kan också svepa mot den – rosen är ett 3×3-tangentbord.)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Торкніться світної клітинки, потім торкніться %1$@ у троянді. (Можна й змахнути до неї — троянда це цифрова клавіатура 3×3.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻点发亮的格子，再轻点花环里的 %1$@。（也可以朝它轻扫 —— 花环就是一个 3×3 的数字键盘。）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輕點發亮的格子，再輕點花環裡的 %1$@。（也可以朝它輕掃 —— 花環就是一個 3×3 的數字鍵盤。）"
          }
        }
      }
    },
