    "history.empty": {
      "comment": "What the History sheet says before there is enough history to chart. Explains what will appear, without urging the player to go and play.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "احلل لوحة وستظهر هنا – الوقت والصعوبة والنقاط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Resol un tauler i apareixerà aquí: temps, dificultat i punts."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Løs et bræt, så havner det her – tid, sværhedsgrad og point."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Löse ein Spielfeld und es landet hier — Zeit, Stufe und Punkte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve a board and it lands here — time, difficulty and points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Resuelve un tablero y aparecerá aquí: tiempo, dificultad y puntos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ratkaise ruudukko, niin se ilmestyy tähän – aika, vaikeus ja pisteet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Résolvez une grille et elle apparaît ici — temps, difficulté et points."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פתור לוח והוא יופיע כאן – זמן, קושי ונקודות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oldjon meg egy táblát, és itt jelenik meg – idő, nehézség és pontok."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leystu borð og það birtist hér – tími, erfiðleikastig og stig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Risolvi una griglia e finisce qui — tempo, difficoltà e punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "盤面を解くと、ここに残ります。タイム、難易度、ポイント。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보드를 풀면 여기에 남아요 — 시간, 난이도, 점수까지요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Løs et brett, så havner det her – tid, vanskelighet og poeng."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los een bord op en het komt hier terecht — tijd, moeilijkheidsgraad en punten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Resolva um tabuleiro e ele aparece aqui — tempo, dificuldade e pontos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lös ett bräde så hamnar det här – tid, svårighet och poäng."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Розв’яжіть поле, і воно з’явиться тут — час, складність і бали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "解出一张棋盘，它就会落在这里 —— 用时、难度和积分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "解出一張棋盤，它就會落在這裡 —— 用時、難度和積分。"
          }
        }
      }
    },
