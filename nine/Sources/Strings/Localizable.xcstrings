          "stringUnit": {
            "state": "needs_review",
            "value": "Готово"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完成"
          }
        }
      }
    },
    "coach.swordfish.sentence.colBase": {
      "comment": "Coach sentence for a column-based Swordfish. The mirror of coach.swordfish.sentence.rowBase, with rows and columns swapped. %1$lld appears twice.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في هذه الأعمدة الثلاثة يمكن للرقم %1$lld أن يقع في ثلاثة صفوف فقط، لذا لا يمكن لأي خانة أخرى في تلك الصفوف أن تكون %1$lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En aquestes tres columnes, %1$lld només pot anar a tres files, així que cap altra casella d'aquestes files pot ser %1$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I disse tre kolonner kan %1$lld kun stå i tre rækker, så ingen andre felter i de rækker kan være %1$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In diesen drei Spalten kann die %1$lld nur in drei Zeilen stehen, also kann kein anderes Feld in diesen Zeilen eine %1$lld sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In these three columns, %1$lld can only sit in three rows, so no other square in those rows can be a %1$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En estas tres columnas, el %1$lld solo cabe en tres filas, así que ninguna otra casilla de esas filas puede ser un %1$lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Näissä kolmessa sarakkeessa numero %1$lld voi olla vain kolmella rivillä, joten mikään muu näiden rivien ruutu ei voi olla numero %1$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans ces trois colonnes, %1$lld ne peut se placer que sur trois lignes, donc aucune autre case de ces lignes ne peut être un %1$lld."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בשלוש העמודות האלה הספרה %1$lld יכולה להופיע רק בשלוש שורות, ולכן אף משבצת אחרת בשורות האלה לא יכולה להיות %1$lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ebben a három oszlopban %1$lld csak három sorban lehet, így ezen sorok más mezői nem lehetnek %1$lld."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Í þessum þremur dálkum getur %1$lld aðeins verið í þremur röðum, svo enginn annar reitur í þeim röðum getur verið %1$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In queste tre colonne, %1$lld può stare solo in tre righe, quindi nessun’altra casella di quelle righe può essere un %1$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この3つの列では %1$lld は3つの行にしか入らないので、その行の他のマスに %1$lld は入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 세 열에서 %1$lld 후보는 같은 세 행에만 있어요. 그래서 그 세 행의 나머지 칸에서는 %1$lld 후보를 지울 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I disse tre kolonnene kan %1$lld bare stå i tre rader, så ingen andre ruter i de radene kan være %1$lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In deze drie kolommen kan %1$lld alleen in drie rijen staan, dus geen ander vakje in die rijen kan een %1$lld zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nestas três colunas, %1$lld só pode ficar em três linhas, então nenhuma outra célula dessas linhas pode ser %1$lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I de här tre kolumnerna kan %1$lld bara stå i tre rader, så ingen annan ruta i de raderna kan vara %1$lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У цих трьох стовпцях цифра %1$lld може стояти лише у трьох рядках, тож жодна інша клітинка цих рядків не може містити цифру %1$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在这三列里，%1$lld 只能落在三行上，所以这三行的其他格子都不能是 %1$lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在這三欄裡，%1$lld 只能落在三列上，所以這三列的其他格子都不能是 %1$lld。"
          }
        }
      }
    },
