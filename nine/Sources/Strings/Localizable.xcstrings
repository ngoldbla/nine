        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allir mögulegir staðir fyrir %1$lld í dálki %2$lld eru í kassa %3$lld, svo enginn annar reitur í kassa %3$lld getur verið %1$lld."
