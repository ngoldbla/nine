    "coach.cageCombination.sentence": {
      "comment": "Coach explanation on a Killer board: a cage's printed total admits only a few sets of digits, and none of the sets still possible puts this digit in this square. %1$lld is the cage's size and %2$lld is the digit being ruled out. \"Cage\" is the outlined group with a printed total.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذا القفص المكوّن من %1$lld خانة لا يقبل إلا عددًا قليلًا من مجموعات الأرقام، ولا تضع أيٌّ من المجموعات الممكنة %2$lld هنا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquesta gàbia de %1$lld caselles només pot contenir uns pocs conjunts de dígits, i cap dels que encara són possibles hi posa %2$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette bur med %1$lld felter kan kun rumme nogle få sæt cifre, og ingen af dem, der stadig er mulige, sætter %2$lld her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Käfig aus %1$lld Feldern kann nur wenige Ziffernsätze aufnehmen, und keiner der noch möglichen setzt hier eine %2$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cage of %1$lld cells can only hold a few sets of digits, and none of the ones still possible puts a %2$lld here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta jaula de %1$lld casillas solo admite unos pocos conjuntos de dígitos, y ninguno de los posibles pone un %2$lld aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä %1$lld ruudun häkki voi sisältää vain muutaman numerosarjan, eikä mikään jäljellä olevista aseta numeroa %2$lld tähän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette cage de %1$lld cases n'admet que quelques ensembles de chiffres, et aucun de ceux encore possibles ne place un %2$lld ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הכלוב הזה בן %1$lld משבצות יכול להכיל רק כמה צירופי ספרות, ואף אחד מהצירופים האפשריים עדיין לא מציב כאן %2$lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ez a %1$lld mezős ketrec csak néhány számjegykombinációt fogadhat el, és a még lehetségesek egyike sem tesz ide %2$lld számot."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Þetta búr með %1$lld reitum getur aðeins innihaldið fáein tölustafasett og ekkert þeirra sem enn eru möguleg setur %2$lld hér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa gabbia da %1$lld caselle ammette solo pochi insiemi di cifre, e nessuno di quelli ancora possibili mette un %2$lld qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld マスのこのケージに入る数字の組み合わせは限られており、まだ可能などの組み合わせもここに %2$lld を置きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld칸 케이지에 들어갈 수 있는 숫자 조합은 몇 가지뿐이며, 아직 가능한 어떤 조합도 여기에 %2$lld을 놓지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette buret med %1$lld ruter kan bare inneholde noen få sett med siffer, og ingen av dem som fortsatt er mulige setter %2$lld her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze kooi van %1$lld vakjes kan maar enkele cijfersets bevatten, en geen van de nog mogelijke zet hier een %2$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta gaiola de %1$lld quadrados só admite alguns conjuntos de dígitos, e nenhum dos ainda possíveis coloca um %2$lld aqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det här buret med %1$lld rutor kan bara innehålla ett fåtal uppsättningar siffror, och ingen av de fortfarande möjliga placerar %2$lld här."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ця клітка з %1$lld клітинок може містити лише кілька наборів цифр, і жоден із можливих не ставить сюди цифру %2$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这个 %1$lld 格笼子只能容纳少数几组数字，而仍然可能的组合中没有一组会在这里放 %2$lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這個 %1$lld 格籠子只能容納少數幾組數字，而仍然可能的組合中沒有一組會在這裡放 %2$lld。"
          }
        }
      }
    },
    "coach.cageSingle.sentence": {
      "comment": "Coach explanation on a Killer board: only one square of a cage is still empty, so the cage's printed total forces its digit. %1$lld is how many squares the cage has and %2$lld is the digit. \"Cage\" is the outlined group with a printed total.",
      "extractionState": "manual",
