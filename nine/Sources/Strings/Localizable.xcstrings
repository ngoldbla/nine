    "board.cell.placeHint": {
      "comment": "VoiceOver hint on an empty square, spoken after the label. Describes how to enter a digit on this platform.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسحب أو استخدم قرص الإجراءات لوضع رقم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Llisca o fes servir el rotor d'accions per col·locar un dígit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stryg eller brug handlingsrotoren for at placere et ciffer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Streiche oder nutze den Aktionenrotor, um eine Ziffer zu setzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flick or use the actions rotor to place a digit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desliza rápido o usa el rotor de acciones para colocar un número."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pyyhkäise tai käytä toimintorotoria numeron asettamiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Balayez ou utilisez le rotor Actions pour placer un chiffre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "החלק או השתמש בגלגל הפעולות כדי להציב ספרה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pöccintsen, vagy használja a műveletforgatót számjegy elhelyezéséhez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strjúktu eða notaðu aðgerðahjólið til að setja tölustaf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scorri con un dito o usa il rotore Azioni per inserire una cifra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フリックするか、アクションローターで数字を置きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "쓸어넘기거나 동작 로터로 숫자를 놓을 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sveip eller bruk handlingsrotoren for å plassere et siffer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veeg of gebruik de actierotor om een cijfer te plaatsen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deslize rápido ou use o rotor de ações para colocar um dígito."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svep eller använd åtgärdsrotorn för att placera en siffra."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Проведіть або скористайтеся ротором дій, щоб поставити цифру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
