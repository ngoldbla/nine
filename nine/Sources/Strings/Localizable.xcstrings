    "difficulty.sharp.explainer": {
      "comment": "The longer explanation of the Sharp band. \"X-wing\" is a term of art. Two short sentences.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتطلب X-Wing واستنتاجات متعددة الطبقات. أحضر الملاحظات والصبر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exigeix X-Wings i deduccions en capes. Porta notes i paciència."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kræver X-wings og lagvise slutninger. Tag noter og tålmodighed med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verlangt X-Wings und verschachtelte Schlüsse. Bring Notizen und Geduld mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demands X-wings and layered deductions. Bring notes and patience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exige X-Wings y deducciones encadenadas. Ven con anotaciones y paciencia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaatii X-wingejä ja kerroksellisia päätelmiä. Ota mukaan muistiinpanot ja kärsivällisyyttä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exige des X-Wing et des déductions en cascade. Prévoyez notes et patience."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "דורש X-Wing והסקות רב-שכבתיות. הבא איתך הערות וסבלנות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "X-Wingeket és többrétegű következtetéseket kíván. Hozzon jegyzeteket és türelmet."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krefst X-Wing og lagskiptra ályktana. Taktu glósur og þolinmæði með."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Richiede X-Wing e deduzioni a più livelli. Servono note e pazienza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "X-Wing と多段の推理が必要です。メモと根気を用意してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "X-Wing과 여러 겹의 추론이 필요해요. 메모와 인내심을 챙겨 오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krever X-wings og lagvise slutninger. Ta med notater og tålmodighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vergt X-Wings en gelaagde redeneringen. Neem notities en geduld mee."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exige X-Wings e deduções em camadas. Traga anotações e paciência."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kräver X-wings och lager av slutledningar. Ta med anteckningar och tålamod."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Потребує X-Wing і багаторівневих висновків. Візьміть нотатки й терпіння."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要 X-Wing 和层层推演。带上笔记和耐心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要 X-Wing 和層層推演。帶上筆記和耐心。"
          }
        }
      }
    },
