    "coach.hiddenPair.sentence.row": {
      "comment": "Coach explanation, hidden pair inside a ROW: two digits fit only two squares there, so nothing else fits in those squares. %1$lld and %2$lld are the digits, %3$lld the row number.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الرقمان %1$lld و%2$lld لا يناسبان في الصف %3$lld إلا هاتين الخانتين، لذا لا يناسب غيرهما هناك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld i %2$lld només caben en aquestes dues caselles de la fila %3$lld, així que no hi cap res més."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld og %2$lld passer kun i disse to felter i række %3$lld, så intet andet passer dér."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld und %2$lld passen in Zeile %3$lld nur in diese beiden Felder, also passt dort nichts anderes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld and %2$lld fit only these two squares in row %3$lld, so nothing else fits there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El %1$lld y el %2$lld solo caben en estas dos casillas de la fila %3$lld, así que ahí no cabe nada más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Numerot %1$lld ja %2$lld sopivat rivillä %3$lld vain näihin kahteen ruutuun, joten mikään muu ei sovi sinne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld et %2$lld ne tiennent que dans ces deux cases de la ligne %3$lld, donc rien d’autre n’y tient."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הספרות %1$lld ו-%2$lld מתאימות בשורה %3$lld רק לשתי המשבצות האלה, ולכן שום דבר אחר לא מתאים שם."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld és %2$lld a(z) %3$lld. sorban csak e két mezőbe fér, így más nem fér oda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld og %2$lld passa aðeins í þessa tvo reiti í röð %3$lld, svo ekkert annað passar þar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld e %2$lld entrano solo in queste due caselle della riga %3$lld, quindi lì non può stare altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%3$lld行では %1$lld と %2$lld がこの2マスにしか入らないので、この2マスには他の数字は入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%3$lld행에서 %1$lld, %2$lld 두 숫자가 들어갈 자리는 이 두 칸뿐이에요. 그래서 다른 숫자는 여기에 들어갈 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld og %2$lld passer bare i disse to rutene i rad %3$lld, så ingenting annet passer der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld en %2$lld passen alleen in deze twee vakjes in rij %3$lld, dus er kan niets anders in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld e %2$lld cabem só nestas duas células da linha %3$lld, então nada mais cabe nelas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld och %2$lld passar bara i de här två rutorna i rad %3$lld, så inget annat passar där."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цифри %1$lld і %2$lld у рядку %3$lld підходять лише для цих двох клітинок, тож більше нічого туди не підходить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在第 %3$lld 行里，%1$lld 和 %2$lld 只能放进这两个格子，所以这两格里放不下别的数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在第 %3$lld 列裡，%1$lld 和 %2$lld 只能放進這兩個格子，所以這兩格裡放不下別的數字。"
          }
        }
      }
    },
    "coach.hiddenSingle.sentence.box": {
      "comment": "Coach explanation, hidden single confined to a 3x3 BOX. %1$lld is the box number (1-9, reading order), %2$lld the digit.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "خانة واحدة فقط في المربع %1$lld تقبل %2$lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Només una casella del bloc %1$lld pot ser %2$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun ét felt i boks %1$lld kan rumme %2$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur ein Feld in Block %1$lld kann eine %2$lld aufnehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one square in box %1$lld can take a %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo una casilla del bloque %1$lld admite un %2$lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vain yksi lohkon %1$lld ruutu voi olla numero %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une seule case du bloc %1$lld peut recevoir un %2$lld."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "רק משבצת אחת בתיבה %1$lld יכולה להכיל %2$lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A(z) %1$lld. blokkban csak egy mező lehet %2$lld."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aðeins einn reitur í kassa %1$lld getur verið %2$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo una casella del riquadro %1$lld può contenere un %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lldブロックで %2$lld が入るマスは1つだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld번 박스에서 %2$lld 후보가 남은 칸은 하나뿐이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bare én rute i boks %1$lld kan ta %2$lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maar één vakje in blok %1$lld kan een %2$lld bevatten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Só uma célula do bloco %1$lld pode receber um %2$lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bara en ruta i block %1$lld kan ta %2$lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лише одна клітинка блока %1$lld може містити цифру %2$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第 %1$lld 宫里只有一个格子能放 %2$lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第 %1$lld 宮裡只有一個格子能放 %2$lld。"
          }
        }
      }
    },
    "coach.hiddenSingle.sentence.cell": {
      "comment": "Coach explanation, hidden single when no containing unit could be named — so this one names the square instead. %1$lld is the row, %2$lld the column, %3$lld the digit. Mentions no row, column or box.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الصف %1$lld، العمود %2$lld هي الخانة الوحيدة المتبقية التي تقبل %3$lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fila %1$lld, columna %2$lld és l'única casella que queda on pot anar %3$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Række %1$lld, kolonne %2$lld er det eneste tilbageværende felt, der kan rumme %3$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeile %1$lld, Spalte %2$lld ist das einzige Feld, das noch eine %3$lld aufnehmen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Row %1$lld, column %2$lld is the only square left that can take a %3$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fila %1$lld, columna %2$lld es la única casilla que ya admite un %3$lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rivi %1$lld, sarake %2$lld on ainoa jäljellä oleva ruutu, johon numero %3$lld sopii."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ligne %1$lld, colonne %2$lld est la seule case pouvant encore recevoir un %3$lld."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שורה %1$lld, עמודה %2$lld היא המשבצת היחידה שנותרה שיכולה להכיל %3$lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A(z) %1$lld. sor %2$lld. oszlopa az egyetlen megmaradt mező, ahová %3$lld kerülhet."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Röð %1$lld, dálkur %2$lld er eini reiturinn sem eftir er þar sem %3$lld getur verið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riga %1$lld, colonna %2$lld è l'unica casella rimasta che può contenere un %3$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%3$lld が入るマスは %2$lld列 %1$lld行だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%3$lld 후보가 남은 칸은 %1$lld행 %2$lld열 하나뿐이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rad %1$lld, kolonne %2$lld er den eneste gjenværende ruten som kan ta %3$lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rij %1$lld, kolom %2$lld is het enige vakje dat nog een %3$lld kan bevatten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linha %1$lld, coluna %2$lld é a única célula que ainda pode receber um %3$lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rad %1$lld, kolumn %2$lld är den enda kvarvarande rutan som kan ta %3$lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рядок %1$lld, стовпець %2$lld — єдина клітинка, що залишилась, куди підходить цифра %3$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第 %1$lld 行第 %2$lld 列是唯一还能放 %3$lld 的格子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第 %1$lld 列第 %2$lld 欄是唯一還能放 %3$lld 的格子。"
          }
        }
      }
    },
