          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כל המקומות שבהם הספרה %1$lld עדיין אפשרית בתיבה %2$lld נמצאים בשורה %3$lld, ולכן אף משבצת אחרת בשורה %3$lld לא יכולה להיות %1$lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A(z) %2$lld. blokkban %1$lld összes lehetséges helye a(z) %3$lld. sorban van, így a(z) %3$lld. sor egyetlen más mezője sem lehet %1$lld."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allir mögulegir staðir fyrir %1$lld í kassa %2$lld eru í röð %3$lld, svo enginn annar reitur í röð %3$lld getur verið %1$lld."
          }
        },
        "it": {
          "stringUnit": {
