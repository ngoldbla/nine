    "grammar.remote.advanceHint": {
      "comment": "One-line reminder of the Siri Remote's controls, under a tutorial beat. \"Rose\" is Nine's circular digit picker; ▶︎ is the play/pause key and stays as the glyph. Middle dots separate the three.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسحب للتحرك · انقر لفتح الوردة · ▶︎ يتراجع"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Llisca per moure't · clica per a la rosa · ▶︎ desfà"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stryg for at flytte · klik for rosen · ▶︎ fortryder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Streichen bewegt · Klick öffnet die Rose · ▶︎ widerruft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe to move · click for the rose · ▶︎ undoes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desliza para moverte · haz clic para la rosa · ▶︎ deshace"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pyyhkäise liikkuaksesi · paina ruusua varten · ▶︎ kumoaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Balayez pour vous déplacer · cliquez pour la rose · ▶︎ annule"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "החלק כדי לזוז · לחץ לפתיחת הוורד · ▶︎ מבטל"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simítson a mozgáshoz · kattintson a rózsához · ▶︎ visszavon"
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strjúktu til að hreyfa · smelltu fyrir rósina · ▶︎ afturkallar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scorri per spostarti · clicca per la rosa · ▶︎ annulla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スワイプで移動 · クリックでリング · ▶︎ で取り消し"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스와이프로 이동 · 클릭으로 꽃 열기 · ▶︎로 실행 취소"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sveip for å flytte · klikk for rosen · ▶︎ angrer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veeg om te bewegen · klik voor de roos · ▶︎ maakt ongedaan"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deslize para mover · clique para a rosa · ▶︎ desfaz"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svep för att flytta · klicka för rosen · ▶︎ ångrar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Проведіть, щоб рухатись · клацніть для троянди · ▶︎ скасовує"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻扫移动 · 点按打开花环 · ▶︎ 撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輕掃移動 · 點按開啟花環 · ▶︎ 還原"
          }
        }
      }
    },
    "grammar.remote.highlightDetail": {
      "comment": "The Siri Remote's full instruction for the same-number highlight.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أبقِ المؤشر على أي رقم موضوع فتضيء كل نسخه – والملاحظات أيضًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deixa el cursor sobre qualsevol dígit col·locat i s'il·luminen totes les còpies, també les notes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parkér markøren på et placeret ciffer, så lyser alle kopier op – noter også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lass den Cursor auf einer gesetzten Ziffer stehen, und jede Kopie leuchtet auf — Notizen auch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Park the cursor on any placed digit and every copy of it lights up — pencil notes too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deja el cursor sobre cualquier número colocado y todas sus copias se iluminan, también las anotaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pysäytä kohdistin mihin tahansa asetettuun numeroon, niin kaikki sen kopiot syttyvät – muistiinpanotkin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laissez le curseur sur un chiffre posé et toutes ses copies s’allument — les notes aussi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "השאר את הסמן על ספרה שהוצבה וכל העותקים שלה נדלקים – גם ההערות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Állítsa a kurzort bármelyik elhelyezett számjegyre, és az összes másolata kigyullad – a jegyzetek is."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leggðu bendilinn á hvaða tölustaf sem er og öll eintök hans lýsast upp – glósur líka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lascia il cursore su una cifra già inserita e tutte le sue copie si illuminano — anche le note a matita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "入力済みの数字にカーソルを置いておくと、同じ数字がすべて光ります。メモの数字も一緒です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "놓인 숫자 위에 커서를 올려 두면 같은 숫자가 모두 밝아져요 — 연필 메모까지요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parker markøren på et plassert siffer, så lyser alle kopier opp – notater også."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parkeer de cursor op een geplaatst cijfer en elk exemplaar ervan licht op — potloodnotities ook."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deixe o cursor parado sobre qualquer dígito colocado e todas as cópias dele acendem — as anotações também."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parkera markören på en placerad siffra så lyser alla kopior upp – anteckningar också."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Залиште курсор на будь-якій поставленій цифрі — усі її копії засвітяться, нотатки теж."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "把光标停在任意已填数字上，所有相同的数字都会亮起 —— 笔记也一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "把游標停在任意已填數字上，所有相同的數字都會亮起 —— 筆記也一樣。"
          }
        }
      }
    },
    "grammar.remote.highlightVerb": {
      "comment": "The Siri Remote's verb for lighting up every copy of a digit: leave the selection sitting on it. Lowercase, mid-sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أبقِ المؤشر"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "deixa el cursor"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "parkér markøren"
          }
        },
        "de": {
          "stringUnit": {
