        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "משבצת אחת בכלוב הזה בן %1$lld משבצות עדיין ריקה, ולכן סכום הכלוב מותיר רק %2$lld."
          }
        },
        "hu": {
