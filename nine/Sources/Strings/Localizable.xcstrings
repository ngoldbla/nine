    "tip.highlight": {
      "comment": "One of three lifetime tips, shown once in a chip. Explains that tapping a placed digit highlights every other copy of it on the board.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المس أي رقم موضوع لإضاءة كل الأرقام المماثلة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca qualsevol dígit col·locat per il·luminar tots els del mateix tipus."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryk på et placeret ciffer for at lyse alle af samme slags op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe eine gesetzte Ziffer an, und alle ihrer Art leuchten auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any placed digit to light up every one of its kind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca cualquier número colocado para iluminar todos los iguales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napauta mitä tahansa asetettua numeroa valaistaksesi kaikki samanlaiset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez un chiffre posé pour allumer tous ses semblables."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הקש על ספרה שהוצבה כדי להדליק את כל הדומות לה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koppintson bármelyik elhelyezett számjegyre az összes azonos kiemeléséhez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pikkaðu á hvaða settan tölustaf sem er til að lýsa upp alla sömu gerðar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tocca una cifra inserita per accendere tutte quelle uguali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "置いた数字をタップすると、同じ数字がすべて光ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "놓인 숫자를 탭하면 같은 숫자가 모두 밝아져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trykk på et plassert siffer for å lyse opp alle av samme slag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik op een geplaatst cijfer om alle cijfers van die soort te laten oplichten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque em qualquer número já colocado para acender todos os iguais."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryck på en placerad siffra för att lysa upp alla av samma sort."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Торкніться будь-якої поставленої цифри, щоб підсвітити всі однакові."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻点任意已填的数字，棋盘上所有相同的数字都会点亮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輕點任意已填的數字，棋盤上所有相同的數字都會點亮。"
          }
        }
      }
    },
    "tip.pencil": {
      "comment": "One of three lifetime tips, shown once in a chip. Explains that the pencil toggle turns entry into corner notes. \"the rose\" is Nine's circular digit picker — keep the metaphor if the language has one, describe it plainly if not.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المس القلم ثم اسحب – تترك الوردة ملاحظات الزاوية بدلًا من ذلك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca el llapis i després llisca: la rosa deixa notes de cantonada."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryk på blyanten og stryg så – rosen efterlader hjørnenoter i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe auf den Stift und streiche – die Rose setzt dann Notizen in die Ecken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the pencil, then flick — the rose leaves corner notes instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca el lápiz y desliza: la rosa deja notas en las esquinas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napauta kynää ja viistä sitten – ruusu jättää kulmamuistiinpanoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez le crayon, puis balayez — la rose inscrit alors des notes dans les coins."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הקש על העיפרון ואז החלק – הוורד משאיר הערות פינה במקום."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koppintson a ceruzára, majd pöccintsen – a rózsa sarokjegyzeteket hagy."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pikkaðu á blýantinn og strjúktu síðan – rósin skilur eftir hornglósur í staðinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tocca la matita, poi scorri — la rosa lascia annotazioni negli angoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メモに切り替えてからはじくと、リングが数字ではなく隅のメモを残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연필을 탭한 뒤 밀어 보세요. 꽃잎이 모서리 메모를 남겨요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trykk på blyanten og sveip så – rosen legger igjen hjørnenotater i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik op het potlood en veeg — de roos zet dan hoeknotities."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque no lápis e deslize — a rosa passa a deixar anotações nos cantos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryck på pennan och svep sedan – rosen lämnar hörnanteckningar i stället."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Торкніться олівця, а потім змахніть — троянда залишить кутові нотатки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻点笔记开关，再轻扫 —— 花环会改为留下角落笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輕點筆記開關，再輕掃 —— 花環會改為留下角落筆記。"
          }
        }
      }
    },
    "tip.undo": {
      "comment": "One of three lifetime tips, shown once in a chip. Explains that undo exists and that nothing can be ruined. Two short sentences; reassuring, never scolding.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التراجع يسترد آخر رقم. لا شيء هنا يعلق نهائيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desfés recupera l'últim dígit. Aquí res no es queda encallat mai."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortryd tager det sidste ciffer tilbage. Intet her sidder nogensinde fast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Widerrufen holt die letzte Ziffer zurück. Hier bleibt nichts je stecken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo takes the last digit back. Nothing here is ever stuck."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deshacer retira el último número. Aquí nada se queda atascado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kumoa ottaa viimeisen numeron takaisin. Mikään täällä ei koskaan jää jumiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Annuler reprend le dernier chiffre. Rien n’est jamais bloqué ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ביטול מחזיר את הספרה האחרונה. שום דבר כאן אינו נתקע לצמיתות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A visszavonás visszaveszi az utolsó számjegyet. Itt soha semmi nem szorul be végleg."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afturkalla tekur síðasta tölustafinn til baka. Ekkert hér festist nokkurn tíma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Annulla riporta indietro l’ultima cifra. Qui non si resta mai bloccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "取り消しで最後の数字を戻せます。行き詰まることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "실행 취소로 마지막 숫자를 되돌려요. 여기선 막히는 일이 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angre tar det siste sifferet tilbake. Ingenting her setter seg noen gang fast."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ongedaan maken neemt het laatste cijfer terug. Niets zit hier ooit vast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desfazer devolve o último número. Nada aqui fica travado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ångra tar tillbaka den senaste siffran. Inget här kör fast för gott."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скасування повертає останню цифру. Тут ніщо не застрягає назавжди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "撤销会收回上一个数字。这里没有什么是无法挽回的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "還原會收回上一個數字。這裡沒有什麼是無法挽回的。"
          }
        }
      }
    },
