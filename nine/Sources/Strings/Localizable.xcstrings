    "why.effect.leaves": {
      "comment": "Final line of a why-chain beat: every other candidate is gone and %1$lld is what remains. One short sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتبقى فقط %1$lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Això deixa només %1$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Så er der kun %1$lld tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit bleibt nur die %1$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That leaves only the %1$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con eso solo queda el %1$lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jäljelle jää vain %1$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il ne reste que le %1$lld."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "נשארת רק %1$lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Így csak %1$lld marad."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Þá er aðeins %1$lld eftir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Così resta solo il %1$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "残るのは %1$lld だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그래서 %1$lld 하나만 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Da gjenstår bare %1$lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daarmee blijft alleen de %1$lld over."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Assim sobra só o %1$lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Då återstår bara %1$lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тоді залишається лише %1$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这样就只剩下 %1$lld 了。"
          }
