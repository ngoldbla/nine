    "coach.nakedPair.sentence.box": {
      "comment": "Coach explanation, naked pair clearing a 3x3 BOX. %1$lld and %2$lld are the two digits, %3$lld the box number.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يملأ الرقمان %1$lld و%2$lld هاتين الخانتين معًا، لذا لا يمكن لأي منهما أن يظهر في أي مكان آخر في المربع %3$lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld i %2$lld omplen aquestes dues caselles entre tots dos, així que cap dels dos pot anar enlloc més del bloc %3$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld og %2$lld udfylder disse to felter mellem sig, så ingen af dem kan stå andre steder i boks %3$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld und %2$lld belegen zusammen diese beiden Felder, also kann keine von beiden woanders in Block %3$lld stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld and %2$lld fill these two squares between them, so neither can go anywhere else in box %3$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El %1$lld y el %2$lld se reparten estas dos casillas, así que ninguno puede ir a otro sitio del bloque %3$lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Numerot %1$lld ja %2$lld täyttävät nämä kaksi ruutua keskenään, joten kumpikaan ei voi olla missään muualla lohkossa %3$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld et %2$lld occupent à eux deux ces deux cases, donc ni l’un ni l’autre ne peut aller ailleurs dans le bloc %3$lld."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הספרות %1$lld ו-%2$lld ממלאות ביניהן את שתי המשבצות האלה, ולכן אף אחת מהן לא יכולה להופיע בשום מקום אחר בתיבה %3$lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld és %2$lld kitölti ezt a két mezőt, így egyik sem lehet máshol a(z) %3$lld. blokkban."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld og %2$lld fylla þessa tvo reiti saman, svo hvorugt getur verið annars staðar í kassa %3$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld e %2$lld si dividono queste due caselle, quindi nessuno dei due può stare altrove nel riquadro %3$lld."
