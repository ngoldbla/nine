    "why.effect.rulesOutMore": {
      "comment": "The same for three or more. Deliberately carries no number — past two the count stops being the point.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذا يستبعد عدة احتمالات أخرى من هذه الخانة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Això descarta diverses possibilitats més d'aquesta casella."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det udelukker flere muligheder i dette felt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit fallen mehrere weitere Möglichkeiten für dieses Feld weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That clears several more possibilities from this square."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con eso desaparecen varias posibilidades más de esta casilla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se poissulkee useita muita mahdollisuuksia tästä ruudusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela écarte plusieurs autres possibilités de cette case."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "זה שולל עוד כמה אפשרויות מהמשבצת הזו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ez még több lehetőséget zár ki ebből a mezőből."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Það útilokar fleiri möguleika úr þessum reit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Così spariscono altre possibilità da questa casella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このマスから、さらにいくつかの候補が消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 칸에서 몇 가지 후보가 더 사라져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det utelukker flere muligheter i denne ruten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daarmee vallen nog meer mogelijkheden voor dit vakje weg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isso tira várias outras possibilidades desta célula."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det utesluter flera fler möjligheter i den här rutan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Це виключає ще кілька можливостей із цієї клітинки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这样这个格子又少了几个可能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這樣這個格子又少了幾個可能。"
          }
        }
      }
    },
    "why.effect.rulesOutOne": {
