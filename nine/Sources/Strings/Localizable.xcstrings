    "firstrun.welcome.tagline": {
      "comment": "Tagline under the welcome heading. \"Couch\" means played from the sofa; the second half says it is on every device the player owns.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سودوكو الأريكة – أينما جلست."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sudoku de sofà: allà on seguis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sofa-sudoku – overalt, hvor du sidder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sudoku fürs Sofa — überall, wo du sitzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couch sudoku — everywhere you sit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sudoku de sofá, allá donde te sientes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sohvasudoku – missä tahansa istutkin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sudoku du canapé — partout où vous vous installez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "סודוקו מהספה – בכל מקום שבו אתה יושב."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanapészudoku – bárhol, ahol leül."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sófa-sudoku – hvar sem þú sest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sudoku da divano — ovunque ti siedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ソファで解く数独 — 座る場所どこでも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "소파에서 즐기는 스도쿠 — 앉는 곳 어디서나."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sofa-sudoku – overalt der du sitter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sudoku voor op de bank — overal waar je zit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sudoku de sofá — onde quer que você se sente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Soffsudoku – överallt där du sitter."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Диванне судоку — де б ви не сиділи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沙发数独 —— 哪里坐下，哪里就能玩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沙發數獨 —— 哪裡坐下，哪裡就能玩。"
          }
        }
      }
    },
    "firstrun.welcome.title": {
