          "stringUnit": {
            "state": "needs_review",
            "value": "Slechts één vakje van deze kooi van %1$lld is nog leeg, dus de kooisom laat alleen een %2$lld toe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Só um quadrado desta gaiola de %1$lld ainda está vazio, então o total da gaiola só admite um %2$lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En ruta i det här buret med %1$lld rutor är fortfarande tom, så burets summa lämnar bara %2$lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В одній клітинці цієї клітки з %1$lld клітинок ще порожньо, тож сума клітки залишає лише цифру %2$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这个 %1$lld 格笼子里只剩一格是空的，所以笼子的和只能是 %2$lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這個 %1$lld 格籠子裡只剩一格是空的，所以籠子的和只能是 %2$lld。"
          }
        }
      }
    },
