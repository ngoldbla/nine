    "coach.simpleColoring.sentence.trap": {
      "comment": "Coach sentence for simple colouring's trap rule: exactly one of the two colours is the true one, so a square seeing both cannot hold the digit. %1$lld appears twice.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إحدى المجموعتين المظلّلتين تحتوي على كل %1$lld، لذا لا يمكن لأي خانة ترى المجموعتين معًا أن تكون %1$lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un dels dos grups ombrejats conté tots els %1$lld, així que cap casella que vegi tots dos grups pot ser %1$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Én af de to skraverede grupper har alle %1$lld, så intet felt, der kan se begge grupper, kan være %1$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine der beiden gefärbten Gruppen enthält jede %1$lld, also kann kein Feld, das beide Gruppen sieht, eine %1$lld sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the two shaded groups holds every %1$lld, so no square that can see both groups can be a %1$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uno de los dos grupos sombreados contiene todos los %1$lld, así que ninguna casilla que vea ambos grupos puede ser un %1$lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toisessa kahdesta varjostetusta ryhmästä on kaikki numerot %1$lld, joten mikään ruutu, joka näkee molemmat ryhmät, ei voi olla numero %1$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’un des deux groupes colorés contient tous les %1$lld, donc aucune case qui voit les deux groupes ne peut être un %1$lld."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "באחת משתי הקבוצות המוצללות נמצאות כל הספרות %1$lld, ולכן אף משבצת שרואה את שתי הקבוצות לא יכולה להיות %1$lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A két árnyékolt csoport egyike tartalmazza az összes %1$lld számot, így egyetlen mező sem lehet %1$lld, amely mindkét csoportot látja."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Annar hópanna tveggja með skugga inniheldur öll %1$lld, svo enginn reitur sem sér báða hópana getur verið %1$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uno dei due gruppi colorati contiene tutti i %1$lld, quindi nessuna casella che vede entrambi i gruppi può essere un %1$lld."
