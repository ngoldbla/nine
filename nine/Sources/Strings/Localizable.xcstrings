    "grammar.keyboard.advanceHint": {
      "comment": "One-line reminder of the Mac keyboard controls, under a tutorial beat. ⌘Z is a keyboard shortcut and stays as the glyphs.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مفاتيح الأسهم تحرّك · الأرقام تضع · ⌘Z يتراجع"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les fletxes mouen · els dígits col·loquen · ⌘Z desfà"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Piletaster flytter · cifre placerer · ⌘Z fortryder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pfeile bewegen · Ziffern setzen · ⌘Z widerruft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrows move · digits place · ⌘Z undoes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las flechas mueven · los números colocan · ⌘Z deshace"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nuolinäppäimet siirtävät · numerot asettavat · ⌘Z kumoaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les flèches déplacent · les chiffres placent · ⌘Z annule"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מקשי החצים מזיזים · ספרות מציבות · ⌘Z מבטל"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A nyilak mozgatnak · a számjegyek elhelyeznek · ⌘Z visszavon"
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Örvar hreyfa · tölustafir setja · ⌘Z afturkallar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le frecce spostano · le cifre inseriscono · ⌘Z annulla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "矢印キーで移動 · 数字キーで入力 · ⌘Z で取り消し"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "화살표로 이동 · 숫자로 놓기 · ⌘Z로 실행 취소"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Piltaster flytter · siffer plasserer · ⌘Z angrer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pijlen bewegen · cijfers plaatsen · ⌘Z maakt ongedaan"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setas movem · dígitos colocam · ⌘Z desfaz"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Piltangenter flyttar · siffror placerar · ⌘Z ångrar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Стрілки рухають · цифри ставлять · ⌘Z скасовує"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "方向键移动 · 数字键填数 · ⌘Z 撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "方向鍵移動 · 數字鍵填數 · ⌘Z 還原"
          }
        }
      }
    },
    "grammar.keyboard.highlightDetail": {
      "comment": "The Mac keyboard instruction for the same-number highlight. \"Space\" is a key name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حرّك المؤشر إلى أي رقم موضوع واضغط على مفتاح المسافة. تضيء كل النسخ – والملاحظات أيضًا. الضغط على المسافة مرة أخرى يطفئ الأضواء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mou el cursor sobre qualsevol dígit col·locat i prem la barra espaciadora. S'il·luminen totes les còpies, també les notes. Prem l'espai un altre cop per apagar els llums."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flyt markøren til et placeret ciffer, og tryk på mellemrum. Alle kopier lyser op – noter også. Mellemrum igen slukker lysene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setze den Cursor auf eine gesetzte Ziffer und drücke die Leertaste. Jede Kopie leuchtet auf — Notizen auch. Noch einmal Leertaste schaltet das Licht aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the cursor onto any placed digit and press Space. Every copy lights up — pencil notes too. Space again switches the lights off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lleva el cursor a cualquier número colocado y pulsa Espacio. Todas sus copias se iluminan, también las anotaciones. Otra vez Espacio y las luces se apagan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siirrä kohdistin mihin tahansa asetettuun numeroon ja paina välilyöntiä. Kaikki kopiot syttyvät – muistiinpanotkin. Välilyönti uudelleen sammuttaa valot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Placez le curseur sur un chiffre posé et appuyez sur Espace. Toutes ses copies s’allument — les notes aussi. Espace à nouveau éteint tout."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הזז את הסמן לכל ספרה שהוצבה ולחץ על מקש הרווח. כל העותקים נדלקים – גם ההערות. לחיצה נוספת על מקש הרווח מכבה את האורות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vigye a kurzort bármelyik elhelyezett számjegyre, és nyomja meg a szóközt. Az összes másolat kigyullad – a jegyzetek is. A szóköz újabb lenyomása kioltja a fényeket."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Færðu bendilinn á hvaða tölustaf sem er og ýttu á bilstöng. Öll eintök lýsast upp – glósur líka. Ýttu aftur á bilstöng til að slökkva ljósin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Porta il cursore su una cifra già inserita e premi Spazio. Tutte le sue copie si illuminano — anche le note a matita. Premi Spazio di nuovo per spegnere le luci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "入力済みの数字にカーソルを合わせてスペースを押します。同じ数字がすべて光り、メモの数字も光ります。もう一度スペースを押すと消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "놓인 숫자 위로 커서를 옮기고 스페이스를 눌러요. 같은 숫자가 모두 밝아져요 — 연필 메모까지요. 스페이스를 다시 누르면 불이 꺼져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flytt markøren til et plassert siffer og trykk mellomrom. Alle kopier lyser opp – notater også. Mellomrom igjen slukker lysene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zet de cursor op een geplaatst cijfer en druk op Spatie. Elk exemplaar licht op — potloodnotities ook. Nogmaals Spatie dooft de lichten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leve o cursor até qualquer dígito colocado e aperte Espaço. Todas as cópias acendem — as anotações também. Espaço de novo apaga as luzes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flytta markören till valfri placerad siffra och tryck på blanksteg. Alla kopior lyser upp – anteckningar också. Blanksteg igen släcker lamporna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перемістіть курсор на будь-яку поставлену цифру й натисніть пробіл. Усі копії засвітяться — нотатки теж. Ще раз пробіл гасить світло."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "把光标移到任意已填数字上，按空格键。所有相同的数字都会亮起，笔记也一样。再按一次空格键关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "把游標移到任意已填數字上，按空格鍵。所有相同的數字都會亮起，筆記也一樣。再按一次空格鍵關閉。"
          }
        }
      }
    },
    "grammar.keyboard.highlightVerb": {
