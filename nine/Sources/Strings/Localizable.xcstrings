    "grammar.touch.advanceHint": {
      "comment": "One-line reminder of the touch controls, under a tutorial beat. \"Rose\" is the circular picker, \"petal\" one of its segments.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المس خانة لفتح الوردة · المس بتلة للوضع"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca una casella per a la rosa · toca un pètal per col·locar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryk på et felt for rosen · tryk på et kronblad for at placere"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Feld antippen öffnet die Rose · Blütenblatt antippen setzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a cell for the rose · tap a petal to place"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca una casilla para la rosa · toca un pétalo para colocar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napauta ruutua ruusua varten · napauta terälehteä asettaaksesi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez une case pour la rose · touchez un pétale pour placer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הקש על משבצת לפתיחת הוורד · הקש על עלה כותרת כדי להציב"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koppintson egy mezőre a rózsáért · koppintson egy szirom elhelyezéshez"
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pikkaðu á reit fyrir rósina · pikkaðu á krónublað til að setja"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tocca una casella per la rosa · tocca un petalo per inserire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "マスをタップでリング · 花びらをタップで入力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "칸을 탭해 꽃 열기 · 꽃잎을 탭해 놓기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trykk på en rute for rosen · trykk på et kronblad for å plassere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik op een vakje voor de roos · tik op een bloemblad om te plaatsen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque numa célula para a rosa · toque numa pétala para colocar"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryck på en ruta för rosen · tryck på ett kronblad för att placera"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Торкніться клітинки для троянди · торкніться пелюстки, щоб поставити"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻点格子打开花环 · 轻点花瓣填入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輕點格子開啟花環 · 輕點花瓣填入"
          }
        }
      }
    },
    "grammar.touch.highlightDetail": {
      "comment": "The touch instruction for the same-number highlight.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المس أي رقم موضوع على اللوحة. تضيء كل النسخ – والملاحظات أيضًا. المس واحدًا مرة أخرى لإطفاء الأضواء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca qualsevol dígit col·locat del tauler. S'il·luminen totes les còpies, també les notes. Toca'n un altre cop per apagar els llums."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryk på et placeret ciffer på brættet. Alle kopier lyser op – noter også. Tryk på ét igen for at slukke lysene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe eine gesetzte Ziffer auf dem Spielfeld an. Jede Kopie leuchtet auf — Notizen auch. Noch einmal antippen schaltet das Licht aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any placed digit on the board. Every copy of it lights up — pencil notes too. Tap one again to switch the lights off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca cualquier número ya colocado en el tablero. Todas sus copias se iluminan, también las anotaciones. Vuelve a tocar uno para apagar las luces."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napauta mitä tahansa asetettua numeroa ruudukossa. Kaikki kopiot syttyvät – muistiinpanotkin. Napauta yhtä uudelleen sammuttaaksesi valot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez un chiffre posé sur la grille. Toutes ses copies s’allument — les notes aussi. Touchez-en un à nouveau pour éteindre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הקש על ספרה שהוצבה על הלוח. כל העותקים נדלקים – גם ההערות. הקש על אחת שוב כדי לכבות את האורות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koppintson bármelyik elhelyezett számjegyre a táblán. Az összes másolat kigyullad – a jegyzetek is. Koppintson újra egyre a fények kioltásához."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pikkaðu á hvaða tölustaf sem er á borðinu. Öll eintök lýsast upp – glósur líka. Pikkaðu aftur á einn til að slökkva ljósin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tocca una cifra già inserita nella griglia. Tutte le sue copie si illuminano — anche le note a matita. Toccane una di nuovo per spegnere le luci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "盤面の入力済みの数字をタップします。同じ数字がすべて光り、メモの数字も光ります。もう一度タップすると消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보드에 놓인 숫자를 탭해요. 같은 숫자가 모두 밝아져요 — 연필 메모까지요. 다시 탭하면 불이 꺼져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trykk på et plassert siffer på brettet. Alle kopier lyser opp – notater også. Trykk på ett igjen for å slukke lysene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik op een geplaatst cijfer op het bord. Elk exemplaar ervan licht op — potloodnotities ook. Tik er nog eens op om de lichten te doven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque em qualquer dígito colocado no tabuleiro. Todas as cópias dele acendem — as anotações também. Toque de novo para apagar as luzes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryck på valfri placerad siffra på brädet. Alla kopior lyser upp – anteckningar också. Tryck på en igen för att släcka lamporna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Торкніться будь-якої поставленої цифри на полі. Усі копії засвітяться — нотатки теж. Торкніться однієї ще раз, щоб погасити світло."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻点棋盘上任意已填数字。所有相同的数字都会亮起 —— 笔记也一样。再轻点一次关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輕點棋盤上任意已填數字。所有相同的數字都會亮起 —— 筆記也一樣。再輕點一次關閉。"
          }
        }
      }
    },
    "grammar.touch.highlightVerb": {
      "comment": "The touch verb for lighting up every copy of a digit. Lowercase, mid-sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
