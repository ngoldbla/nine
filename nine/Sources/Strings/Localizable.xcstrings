    "tutorial.difficulty.body": {
      "comment": "The promise behind every board Nine composes, plus how points work. \"Provably\" is load-bearing: the app verifies it, so this is a claim of fact.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كل مستوى صعوبة قابل للحل بالمنطق وحده – بلا تخمين أبدًا. الحلول تمنح نقاطًا؛ والأسرع والأصعب يمنح أكثر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada dificultat és demostrablement resoluble només amb lògica: mai cal endevinar. Les resolucions donen punts; més ràpid i més difícil en dona més."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver sværhedsgrad kan bevisligt løses med ren logik – aldrig gætværk. Løsninger giver point; hurtigere og sværere giver mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder Schwierigkeitsgrad ist nachweislich allein mit Logik lösbar – niemals Raten. Jede Lösung bringt Punkte; schneller und schwerer bringt mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every difficulty is provably solvable by logic alone — no guessing, ever. Solves earn points; faster and harder earns more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todas las dificultades se pueden resolver solo con lógica, y está comprobado: nunca hay que adivinar. Resolver da puntos; cuanto más rápido y más difícil, más puntos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jokainen vaikeustaso on todistetusti ratkaistavissa pelkällä logiikalla – ei koskaan arvaamista. Ratkaisut tuovat pisteitä; nopeampi ja vaikeampi tuo enemmän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque niveau de difficulté est résoluble par la seule logique, c’est prouvé — jamais besoin de deviner. Résoudre rapporte des points ; plus vite et plus difficile, plus vous en gagnez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כל רמת קושי ניתנת לפתרון בהיגיון בלבד – בלי ניחושים, אף פעם. פתרונות מזכים בנקודות; מהר וקשה יותר מזכה ביותר."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minden nehézségi szint bizonyíthatóan megoldható pusztán logikával – soha nem kell találgatni. A megoldások pontot érnek; a gyorsabb és nehezebb többet."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvert erfiðleikastig er sannanlega leysanlegt með rökhugsun einni saman – aldrei ágiskun. Lausnir gefa stig; hraðar og erfiðara gefur meira."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni difficoltà è dimostrabilmente risolvibile con la sola logica — mai per tentativi. Risolvere dà punti; più in fretta e più difficile, più punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "どの難易度も、論理だけで必ず解けることを確かめてあります。あてずっぽうは要りません。解くとポイントが入り、速いほど、難しいほど多くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 난이도는 논리만으로 풀린다는 것이 증명돼 있어요. 찍을 일은 없어요. 완성하면 점수를 얻고, 빠르고 어려울수록 더 많이 받아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver vanskelighetsgrad kan bevisst løses med ren logikk – aldri gjetting. Løsninger gir poeng; raskere og vanskeligere gir mer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke moeilijkheidsgraad is aantoonbaar op te lossen met pure logica — nooit gokken. Oplossingen leveren punten op; sneller en moeilijker levert meer op."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toda dificuldade é comprovadamente solucionável só com lógica — nunca é preciso chutar. Cada solução rende pontos; mais rápido e mais difícil rende mais."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varje svårighetsgrad går att lösa med enbart logik – aldrig någon gissning. Lösningar ger poäng; snabbare och svårare ger mer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожен рівень складності доведено розв’язним самою логікою — жодних здогадок. Розв’язки дають бали; швидше й складніше — більше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个难度都经过验证，可仅凭逻辑解出，永远不需要猜。解出棋盘会获得积分，越快、越难，积分越多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每個難度都經過驗證，可僅憑邏輯解出，永遠不需要猜。解出棋盤會獲得積分，越快、越難，積分越多。"
          }
        }
      }
    },
