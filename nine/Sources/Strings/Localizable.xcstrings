    "grammar.remote.placeDetail": {
      "comment": "The Siri Remote's full instruction for placing a digit. %1$@ is the target numeral. \"Rose\" is the circular picker and \"petal\" one of its nine segments — keep the flower metaphor if this language has one.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسحب إلى الخانة المضيئة وانقر لفتح الوردة، ثم اسحب نحو %1$@ – أو اسحب إلى بتلة وانقر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Llisca fins a la casella lluminosa i clica per a la rosa, després llisca cap a %1$@, o llisca fins a un pètal i clica."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stryg til det lysende felt, og klik for rosen, og stryg så mod %1$@ – eller stryg til et kronblad, og klik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Streiche zum leuchtenden Feld und klicke für die Rose, dann schnippe Richtung %1$@ — oder streiche zu einem Blütenblatt und klicke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe to the glowing cell and click for the rose, then flick toward %1$@ — or swipe to a petal and click."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desliza hasta la casilla iluminada y haz clic para abrir la rosa; luego desliza rápido hacia %1$@, o ve hasta un pétalo y haz clic."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pyyhkäise hehkuvaan ruutuun ja paina ruusua varten, pyyhkäise sitten kohti numeroa %1$@ – tai pyyhkäise terälehteen ja paina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Balayez jusqu’à la case qui brille et cliquez pour la rose, puis faites glisser vers %1$@ — ou balayez jusqu’à un pétale et cliquez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "החלק למשבצת הזוהרת ולחץ לפתיחת הוורד, ואז החלק לעבר %1$@ – או החלק לעלה כותרת ולחץ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simítson a világító mezőre, és kattintson a rózsáért, majd simítson a(z) %1$@ felé – vagy simítson egy szirom felé, és kattintson."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strjúktu á lýsandi reitinn og smelltu fyrir rósina, strjúktu síðan í átt að %1$@ – eða strjúktu á krónublað og smelltu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scorri fino alla casella illuminata e clicca per la rosa, poi scorri rapidamente verso %1$@ — oppure scorri fino a un petalo e clicca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スワイプで光っているマスまで進み、クリックしてリングを開きます。あとは%1$@の方へフリックするか、花びらまでスワイプしてクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "빛나는 칸까지 스와이프하고 클릭해 꽃을 연 다음 %1$@ 쪽으로 튕겨요 — 아니면 꽃잎까지 스와이프해서 클릭해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sveip til den lysende ruten og klikk for rosen, og sveip så mot %1$@ – eller sveip til et kronblad og klikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veeg naar het oplichtende vakje en klik voor de roos, zwiep dan naar %1$@ — of veeg naar een bloemblad en klik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deslize até a célula acesa e clique para abrir a rosa, depois deslize rápido na direção do %1$@ — ou deslize até a pétala e clique."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svep till den lysande rutan och klicka för rosen, svep sedan mot %1$@ – eller svep till ett kronblad och klicka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Проведіть до світної клітинки й клацніть для троянди, потім проведіть до %1$@ — або проведіть до пелюстки й клацніть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻扫到发亮的格子并点按，打开花环，然后朝 %1$@ 轻扫 —— 或者扫到花瓣上再点按。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輕掃到發亮的格子並點按，開啟花環，然後朝 %1$@ 輕掃 —— 或者掃到花瓣上再點按。"
          }
        }
      }
    },
