    "grammar.keyboard.pencilDetail": {
      "comment": "The Mac keyboard instruction for pencil notes. \"Shift\" and \"P\" are key names; \"sticky\" means the mode stays on until switched off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اضغط مع الاستمرار على Shift ثم اضغط رقمًا لتدوين ملاحظة – صغيرة في الزاوية إلى أن يحلّ رقم حقيقي. اضغط P للقلم الثابت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén premut Maj i prem un dígit per anotar-lo: petit a la cantonada fins que aterri un dígit de debò. Prem P per al llapis fix."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold Skift nede, og tryk på et ciffer for at notere – lille i hjørnet, til et rigtigt ciffer lander. Tryk på P for fast blyant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Halte Umschalt und drücke eine Ziffer für eine Notiz — klein in der Ecke, bis eine echte Ziffer kommt. P schaltet den Bleistift dauerhaft ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Shift and press a digit to pencil a note — small in the corner until a real digit lands. Press P for sticky pencil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén Mayús y pulsa un número para anotarlo a lápiz: queda pequeño en la esquina hasta que llegue un número de verdad. Pulsa P para el lápiz fijo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pidä Vaihto painettuna ja paina numeroa tehdäksesi muistiinpanon – pieni kulmassa, kunnes oikea numero laskeutuu. Paina P pysyvää kynää varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maintenez Maj et appuyez sur un chiffre pour poser une note — petite dans le coin jusqu’à ce qu’un vrai chiffre arrive. Appuyez sur P pour le crayon permanent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "החזק Shift ולחץ על ספרה כדי לרשום הערה – קטנה בפינה עד שתנחת ספרה אמיתית. לחץ על P לעיפרון קבוע."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tartsa lenyomva a Shift billentyűt, és nyomjon meg egy számjegyet egy jegyzet írásához – kicsiben a sarokban, amíg egy valódi számjegy meg nem érkezik. A P billentyű a tartós ceruzát kapcsolja."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haltu inni Shift og ýttu á tölustaf til að skrifa glósu – lítil í horninu þar til alvöru tölustafur lendir. Ýttu á P fyrir fastan blýant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tieni premuto Maiuscole e premi una cifra per annotarla a matita — piccola nell'angolo finché non arriva una cifra vera. Premi P per la matita fissa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shift を押しながら数字キーを押すとメモを書けます。確定の数字が入るまで隅に小さく残ります。P でメモモードを固定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shift를 누른 채 숫자를 누르면 메모가 남아요 — 진짜 숫자가 들어올 때까지 구석에 작게 있어요. P를 누르면 연필이 계속 켜져 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold inne Skift og trykk på et siffer for å notere – lite i hjørnet til et ekte siffer lander. Trykk P for fast blyant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Houd Shift ingedrukt en druk op een cijfer om een notitie te zetten — klein in de hoek tot er een echt cijfer landt. Druk op P voor vast potlood."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Segure Shift e aperte um dígito para anotar a lápis — pequeno no canto até um dígito de verdade chegar. Aperte P para o lápis fixo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Håll ned Skift och tryck på en siffra för att anteckna – liten i hörnet tills en riktig siffra landar. Tryck på P för klistrig penna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Утримуйте Shift і натисніть цифру, щоб записати нотатку — маленьку в кутку, доки не з’явиться справжня цифра. Натисніть P для постійного олівця."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按住 Shift 再按数字键，就能写下一条笔记 —— 它小小地待在角落，直到真正的数字落下。按 P 键进入常开笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按住 Shift 再按數字鍵，就能寫下一條筆記 —— 它小小地待在角落，直到真正的數字落下。按 P 鍵進入常開筆記。"
          }
        }
      }
    },
