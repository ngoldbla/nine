    "coach.boxLine.sentence.colToBox": {
      "comment": "Coach explanation, box-line reduction claiming a COLUMN's digit INTO a box. %1$lld is the digit, %2$lld the column number, %3$lld the box number. %1$lld and %3$lld each appear twice.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كل مواضع الرقم %1$lld المحتملة في العمود %2$lld تقع في المربع %3$lld، لذا لا يمكن لأي خانة أخرى في المربع %3$lld أن تكون %1$lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tots els %1$lld que encara són possibles a la columna %2$lld són al bloc %3$lld, així que cap altra casella del bloc %3$lld pot ser %1$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle %1$lld, der stadig er mulige i kolonne %2$lld, ligger i boks %3$lld, så ingen andre felter i boks %3$lld kan være %1$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede noch mögliche %1$lld in Spalte %2$lld liegt in Block %3$lld, also kann kein anderes Feld in Block %3$lld eine %1$lld sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every %1$lld still possible in column %2$lld sits in box %3$lld, so no other square in box %3$lld can be a %1$lld."
