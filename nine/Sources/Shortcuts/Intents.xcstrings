    "intent.startBoard.description": {
      "comment": "One sentence under the action name. Sentence case.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يبدأ لغزًا جديدًا بمستوى الصعوبة الذي تختاره."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starter en ny opgave med den sværhedsgrad, du vælger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Startet ein neues Rätsel in der gewählten Schwierigkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a fresh puzzle at the difficulty you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Empieza un puzle nuevo en la dificultad que elijas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aloittaa uuden pulman valitsemallasi vaikeustasolla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Commence une nouvelle grille dans la difficulté choisie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מתחיל חידה חדשה ברמת הקושי שתבחר."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inizia un nuovo puzzle nella difficoltà scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選んだ難易度で新しいパズルを始めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택한 난이도로 새 퍼즐을 시작합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starter et nytt puslespill med vanskelighetsgraden du velger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start een nieuwe puzzel in de moeilijkheid die je kiest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Começa um puzzle novo na dificuldade escolhida."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Startar ett nytt pussel med den svårighetsgrad du väljer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以你选择的难度开始一局新谜题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以你選擇的難度開始一局新謎題。"
          }
        }
      }
    },
