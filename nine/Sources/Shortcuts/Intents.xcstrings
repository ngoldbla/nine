    "intent.boardWidget.description": {
      "comment": "One sentence in the widget-configuration sheet. Sentence case.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لغز اليوم، لمسة واحدة في كل مرة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dagens opgave, ét tryk ad gangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das heutige Rätsel, ein Tippen auf einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's puzzle, one tap at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El puzle de hoy, un toque a la vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Päivän pulma, yksi napautus kerrallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La grille du jour, un geste à la fois."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "החידה של היום, הקשה אחת בכל פעם."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il puzzle di oggi, un tocco alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今日のパズルを、ひとタップずつ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오늘의 퍼즐을 한 번에 한 번씩."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dagens puslespill, ett trykk om gangen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De puzzel van vandaag, tik voor tik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O puzzle de hoje, um toque por vez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dagens pussel, ett tryck i taget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今天的谜题，一次一下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今天的謎題，一次一下。"
          }
        }
      }
    },
