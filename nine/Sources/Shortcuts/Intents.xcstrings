    "intent.continue.description": {
      "comment": "One sentence under the action name. Sentence case.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعيد فتح اللوحة التي كنت تلعبها آخر مرة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbner det bræt, du sidst spillede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffnet das Spielfeld, das du zuletzt gespielt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopens the board you were last playing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuelve a abrir el tablero que estabas jugando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avaa ruudukon, jota pelasit viimeksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rouvre la grille sur laquelle vous jouiez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פותח מחדש את הלוח ששיחקת בו לאחרונה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riapre la griglia su cui stavi giocando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最後に遊んでいた盤面をもう一度開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "마지막으로 하던 보드를 다시 엽니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpner brettet du spilte sist."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opent het bord waar je het laatst mee bezig was."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reabre o tabuleiro em que você estava jogando."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öppnar brädet du spelade senast igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新打开你上次在玩的棋盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新開啟你上次在玩的棋盤。"
          }
        }
      }
    },
